BasedOnStyle: LLVM
IndentWidth: 4
ObjCBlockIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 0
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: false
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: false
IndentCaseLabels: false
PointerAlignment: Left
DerivePointerAlignment: false
SortIncludes: Never
BinPackArguments: true
BinPackParameters: false
