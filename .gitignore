# 기본 Visual Studio .gitignore 설정
## 가이드: https://aka.ms/vs-gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated)
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio generated folders
.vs/
.vscode/
.vscode-test/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# SQL Server files
*.mdf
*.ldf

# Web publish folder
.publish/

# Publish app data
App_Data/

# Generated Dothome catalog artifacts
/deploy/dothome/html/timetable-generator/catalog/

# Local product configuration and generated QA artifacts
/Directory.Build.local.props
/src/TimetableGenerator.Desktop/catalog-source.local.json
/src/TimetableGenerator.Desktop/google-calendar.local.json
/artifacts/
/docs/local/
**/TestResults/

# macOS metadata
.DS_Store
._*
__MACOSX/

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCop.Cache

# Local environment and secret files
.env
.env.*
!.env.example
!.env.*.example
*.env
secrets*.json
appsettings.*.local.json

# Python environments & source files
*.venv
ENV/
env/
venv/
__pycache__/
*.py[cod]

# Test and coverage reports
*.trx
*.coverage
*.coveragexml
/coverage/

# Logs and local reports
*.log

# Java class files
*.class

# Certificates and signing credentials
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
AuthKey_*.p8
*.snk
*.jks
*.keystore
*.mobileprovision

# School source workbooks and generated catalogs
*.xls
*.xlsx
*.xlsm
catalog-r*.json
/index.json

# Local planning workspaces
workspace-v*.json
workspace-v*.g*.json

# Visual Studio Code workspace
*.code-workspace

# Custom build rules
*.rule

# Windows crash dump files
*.dmp

# JetBrains Rider
.idea/

# Rider-specific files
*.sln.iml

# Backup files
*.bak
*.old
*.orig
*.tmp

# Temporary lock files
~$*
