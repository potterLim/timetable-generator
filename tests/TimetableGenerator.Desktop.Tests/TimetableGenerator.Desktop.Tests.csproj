<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimetableGenerator.Desktop\TimetableGenerator.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
        Include="..\..\src\TimetableGenerator.Desktop\Assets\AppIcon.png"
        Link="ProductAssets\AppIcon.png"
        CopyToOutputDirectory="PreserveNewest" />
    <None
        Include="..\..\src\TimetableGenerator.Desktop\Platforms\Windows\AppIcon.ico"
        Link="ProductAssets\AppIcon.ico"
        CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target
      Name="CopyMacOSEventKitBridgeForTests"
      AfterTargets="Build"
      Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy
        SourceFiles="$(MSBuildThisFileDirectory)../../src/TimetableGenerator.Desktop/bin/$(Configuration)/$(TargetFramework)/libTimetableGenerator.EventKitBridge.dylib"
        DestinationFiles="$(TargetDir)libTimetableGenerator.EventKitBridge.dylib" />
  </Target>
</Project>
