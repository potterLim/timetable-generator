<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>TimetableGenerator</AssemblyName>
    <RootNamespace>TimetableGenerator.Desktop</RootNamespace>
    <AssemblyTitle>Timetable Generator</AssemblyTitle>
    <Product>Timetable Generator</Product>
    <Description>과목을 조합하고 가능한 시간표를 비교하는 Windows 및 macOS 데스크톱 앱.</Description>
    <Version>1.0.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>potterLim</Authors>
    <Company>potterLim</Company>
    <Copyright>Copyright © 2026 potterLim</Copyright>
    <RepositoryUrl>https://github.com/potterLim/timetable-generator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT') Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(RuntimeIdentifier)', '^win(-|$)'))">
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
    <ApplicationIcon>Platforms\Windows\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <EventKitBridgeFileName>libTimetableGenerator.EventKitBridge.dylib</EventKitBridgeFileName>
    <EventKitBridgeIntermediateDirectory>$(MSBuildProjectDirectory)/obj/native/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)</EventKitBridgeIntermediateDirectory>
    <EventKitBridgeIntermediatePath>$(EventKitBridgeIntermediateDirectory)/$(EventKitBridgeFileName)</EventKitBridgeIntermediatePath>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <EventKitBridgeSource Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitBridge.m" />
    <EventKitBridgeSource Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitEventIdentity.m" />
    <EventKitBridgeSource Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitExport.m" />
    <EventKitBridgeSource Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitProtocol.m" />
    <EventKitBridgeSource Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitRegistration.m" />
    <EventKitBridgeHeader Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitBridge.h" />
    <EventKitBridgeHeader Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitEventIdentity.h" />
    <EventKitBridgeHeader Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitExport.h" />
    <EventKitBridgeHeader Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitProtocol.h" />
    <EventKitBridgeHeader Include="$(MSBuildProjectDirectory)/Platforms/macOS/EventKitBridge/TimetableGeneratorEventKitRegistration.h" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource
        Include="Assets\**"
        Exclude="Assets\Fonts\Pretendard\LICENSE.txt;Assets\Export\FluentUiSystemIcons.LICENSE.txt" />
    <Content Include="Assets\Fonts\Pretendard\LICENSE.txt">
      <Link>ThirdPartyNotices\Pretendard-LICENSE.txt</Link>
      <TargetPath>ThirdPartyNotices\Pretendard-LICENSE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Export\FluentUiSystemIcons.LICENSE.txt">
      <Link>ThirdPartyNotices\FluentUiSystemIcons-LICENSE.txt</Link>
      <TargetPath>ThirdPartyNotices\FluentUiSystemIcons-LICENSE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ThirdPartyNotices\*.txt">
      <Link>ThirdPartyNotices\%(Filename)%(Extension)</Link>
      <TargetPath>ThirdPartyNotices\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content
        Include="catalog-source.local.json"
        Condition="Exists('catalog-source.local.json')"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
    <Content
        Include="google-calendar.local.json"
        Condition="Exists('google-calendar.local.json')"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimetableGenerator.Application\TimetableGenerator.Application.csproj" />
    <ProjectReference Include="..\TimetableGenerator.CatalogJson\TimetableGenerator.CatalogJson.csproj" />
    <ProjectReference Include="..\TimetableGenerator.Domain\TimetableGenerator.Domain.csproj" />
    <ProjectReference Include="..\TimetableGenerator.Infrastructure\TimetableGenerator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>

  <Target
      Name="CompileMacOSEventKitBridge"
      BeforeTargets="CoreCompile"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64')"
      Inputs="$(MSBuildProjectFullPath);@(EventKitBridgeSource);@(EventKitBridgeHeader)"
      Outputs="$(EventKitBridgeIntermediatePath)">
    <MakeDir Directories="$(EventKitBridgeIntermediateDirectory)" />
    <Exec
        Command="/usr/bin/xcrun --sdk macosx clang -arch arm64 -mmacosx-version-min=14.0 -fobjc-arc -fblocks -fvisibility=hidden -Wall -Wextra -Werror -Wshadow -Wmissing-prototypes -Wmissing-variable-declarations -Wstrict-prototypes -dynamiclib -framework Foundation -framework EventKit -install_name @rpath/$(EventKitBridgeFileName) -o &quot;$(EventKitBridgeIntermediatePath)&quot; @(EventKitBridgeSource->'&quot;%(FullPath)&quot;', ' ')" />
    <ItemGroup>
      <FileWrites Include="$(EventKitBridgeIntermediatePath)" />
    </ItemGroup>
  </Target>

  <Target
      Name="CopyMacOSEventKitBridgeToOutput"
      AfterTargets="Build"
      DependsOnTargets="CompileMacOSEventKitBridge"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <Copy
        SourceFiles="$(EventKitBridgeIntermediatePath)"
        DestinationFiles="$(TargetDir)$(EventKitBridgeFileName)"
        SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)$(EventKitBridgeFileName)" />
    </ItemGroup>
  </Target>

  <Target
      Name="CopyMacOSEventKitBridgeToPublish"
      AfterTargets="Publish"
      DependsOnTargets="CompileMacOSEventKitBridge"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == 'osx-arm64'">
    <Copy
        SourceFiles="$(EventKitBridgeIntermediatePath)"
        DestinationFiles="$(PublishDir)$(EventKitBridgeFileName)"
        SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(EventKitBridgeFileName)" />
    </ItemGroup>
  </Target>

  <Target
      Name="RejectMacOSPublishWithoutNativeToolchain"
      BeforeTargets="Publish"
      Condition="!$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == 'osx-arm64'">
    <Error Text="The macOS target must be published on macOS so the EventKit native bridge can be compiled." />
  </Target>
</Project>
