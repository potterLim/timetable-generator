      <SolidColorBrush x:Key="CourseGreenBackgroundBrush" Color="#E8F6EE" />
      <SolidColorBrush x:Key="CourseGreenBorderBrush" Color="#43805F" />
      <SolidColorBrush x:Key="PersonalScheduleBackgroundBrush" Color="#EEF0FF" />
      <SolidColorBrush x:Key="PersonalScheduleBorderBrush" Color="#6D75B4" />
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FAFBFC" />
      <SolidColorBrush x:Key="CaptionButtonBackground" Color="#EEF4FA" />
