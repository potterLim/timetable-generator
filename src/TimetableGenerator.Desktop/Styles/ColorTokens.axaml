      <SolidColorBrush x:Key="ErrorBrush" Color="#FF7B72" />
      <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#3D1F24" />
      <SolidColorBrush x:Key="ProductDangerActionFillBrush" Color="#B62324" />
      <SolidColorBrush x:Key="ProductDangerActionHoverFillBrush" Color="#C93232" />
      <SolidColorBrush x:Key="ProductDangerActionPressedFillBrush" Color="#8E1B1C" />
      <SolidColorBrush x:Key="ProductOnDangerActionFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PreferencePreferredFillBrush" Color="#1D5FBF" />
      <SolidColorBrush x:Key="PreferencePreferredBorderBrush" Color="#58A6FF" />
      <SolidColorBrush x:Key="PreferencePreferredForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PreferenceAcceptableFillBrush" Color="#1C2D41" />
      <SolidColorBrush x:Key="PreferenceAcceptableBorderBrush" Color="#388BFD" />
      <SolidColorBrush x:Key="PreferenceAcceptableForegroundBrush" Color="#A5D6FF" />
      <SolidColorBrush x:Key="PreferenceExcludedFillBrush" Color="#21262D" />
      <SolidColorBrush x:Key="PreferenceExcludedBorderBrush" Color="#6E7681" />
      <SolidColorBrush x:Key="PreferenceExcludedForegroundBrush" Color="#B1BAC4" />
      <SolidColorBrush x:Key="CourseBlueBackgroundBrush" Color="#172A46" />
      <SolidColorBrush x:Key="CourseBlueBorderBrush" Color="#388BFD" />
      <SolidColorBrush x:Key="CoursePurpleBackgroundBrush" Color="#2D223D" />
      <SolidColorBrush x:Key="CoursePurpleBorderBrush" Color="#A371F7" />
      <SolidColorBrush x:Key="CourseGreenBackgroundBrush" Color="#1B2E22" />
      <SolidColorBrush x:Key="CourseGreenBorderBrush" Color="#3FB950" />
      <SolidColorBrush x:Key="PersonalScheduleBackgroundBrush" Color="#24283A" />
      <SolidColorBrush x:Key="PersonalScheduleBorderBrush" Color="#7D86C5" />
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#10151C" />
      <SolidColorBrush x:Key="CaptionButtonBackground" Color="#21262D" />
      <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#30363D" />
      <SolidColorBrush x:Key="CaptionButtonForeground" Color="#F0F6FC" />
