      <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#334A60" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="#80000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#303F50" />
      <SolidColorBrush x:Key="PaneDividerBrush" Color="#394B5D" />
      <SolidColorBrush x:Key="StrongBorderBrush" Color="#465D72" />
      <SolidColorBrush x:Key="ControlBorderBrush" Color="#71869F" />
      <SolidColorBrush x:Key="ScheduleHourGridLineBrush" Color="#465361" />
