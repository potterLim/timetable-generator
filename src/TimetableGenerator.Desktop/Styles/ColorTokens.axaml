      <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#303843" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
      <SolidColorBrush x:Key="PaneDividerBrush" Color="#3D444D" />
