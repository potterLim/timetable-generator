        <GradientStop Color="#F7F8FA" Offset="0.56" />
        <GradientStop Color="#F1F4F8" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#FAFBFC" />
