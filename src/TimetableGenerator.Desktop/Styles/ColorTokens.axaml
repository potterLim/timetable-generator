      <SolidColorBrush x:Key="CaptionCloseButtonPressedBackgroundBrush" Color="#A82D27" />
      <BoxShadows x:Key="DialogBoxShadow">0 18 48 0 #33000000</BoxShadows>
      <BoxShadows x:Key="ToastBoxShadow">0 8 24 0 #24000000</BoxShadows>
    </ResourceDictionary>

