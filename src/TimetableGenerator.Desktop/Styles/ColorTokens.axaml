      <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#69A9FF" />
      <SolidColorBrush x:Key="ProductPrimaryActionFillBrush" Color="#1B63C9" />
      <SolidColorBrush x:Key="ProductPrimaryActionHoverFillBrush" Color="#236ED4" />
      <SolidColorBrush x:Key="ProductPrimaryActionPressedFillBrush" Color="#154C9D" />
      <SolidColorBrush x:Key="ProductOnPrimaryActionFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ProductFocusStrokeBrush" Color="#69A9FF" />
      <SolidColorBrush x:Key="ProductFocusOnFillStrokeBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#56C596" />
      <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#173529" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F0B95A" />
      <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3B2D16" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FF8794" />
      <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#3E2028" />
      <SolidColorBrush x:Key="ProductDangerActionFillBrush" Color="#B83449" />
      <SolidColorBrush x:Key="ProductDangerActionHoverFillBrush" Color="#CA4055" />
      <SolidColorBrush x:Key="ProductDangerActionPressedFillBrush" Color="#92283A" />
      <SolidColorBrush x:Key="ProductOnDangerActionFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CourseBlueBackgroundBrush" Color="#182C48" />
      <SolidColorBrush x:Key="CourseBlueBorderBrush" Color="#5795E6" />
      <SolidColorBrush x:Key="CoursePurpleBackgroundBrush" Color="#2B243C" />
      <SolidColorBrush x:Key="CoursePurpleBorderBrush" Color="#A98AD6" />
      <SolidColorBrush x:Key="CourseGreenBackgroundBrush" Color="#1B3028" />
      <SolidColorBrush x:Key="CourseGreenBorderBrush" Color="#61A47F" />
      <SolidColorBrush x:Key="PersonalScheduleBackgroundBrush" Color="#252A43" />
      <SolidColorBrush x:Key="PersonalScheduleBorderBrush" Color="#8A91CD" />
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#12151A" />
      <SolidColorBrush x:Key="CaptionButtonBackground" Color="#222F3B" />
      <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#303F50" />
      <SolidColorBrush x:Key="CaptionButtonForeground" Color="#F4F7FB" />
