      <SolidColorBrush x:Key="ProductFocusOnFillStrokeBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#147A55" />
      <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E8F5EF" />
      <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF4D6" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#C43246" />
      <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FDECEF" />
      <SolidColorBrush x:Key="ProductDangerActionFillBrush" Color="#B4233C" />
