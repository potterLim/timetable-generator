      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66717F" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0860CA" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#0757BA" />
      <SolidColorBrush x:Key="AccentTintBrush" Color="#DDF4FF" />
      <SolidColorBrush x:Key="ProductPrimaryActionFillBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="ProductPrimaryActionHoverFillBrush" Color="#0860CA" />
      <SolidColorBrush x:Key="ProductPrimaryActionPressedFillBrush" Color="#0757BA" />
