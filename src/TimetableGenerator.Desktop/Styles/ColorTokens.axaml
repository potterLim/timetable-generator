<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FA" />
      <LinearGradientBrush
          x:Key="WorkspaceBackdropBrush"
          StartPoint="0%,0%"
          EndPoint="100%,100%">
        <GradientStop Color="#FBFCFE" Offset="0" />
        <GradientStop Color="#F7F8FA" Offset="0.56" />
        <GradientStop Color="#F1F4F8" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#FAFBFC" />
      <SolidColorBrush x:Key="PaneSurfaceBrush" Color="#F3F5F8" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F8FA" />
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ControlHoverSurfaceBrush" Color="#EEF5FD" />
      <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#EEF4FA" />
      <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E8F1FB" />
      <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#DCE9F7" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="#52101828" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D7E3F0" />
      <SolidColorBrush x:Key="PaneDividerBrush" Color="#CBD9E8" />
