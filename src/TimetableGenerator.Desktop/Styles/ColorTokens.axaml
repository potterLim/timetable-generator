      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#526176" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#627188" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0A60C8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0857B6" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#064A9B" />
      <SolidColorBrush x:Key="AccentTintBrush" Color="#E5F2FF" />
      <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="#E6F0FF" />
