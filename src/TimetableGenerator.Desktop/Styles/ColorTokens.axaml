<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F8FC" />
      <LinearGradientBrush
          x:Key="WorkspaceBackdropBrush"
          StartPoint="0%,0%"
          EndPoint="100%,100%">
        <GradientStop Color="#FAFCFF" Offset="0" />
        <GradientStop Color="#F6F8FC" Offset="0.56" />
        <GradientStop Color="#F1F5FA" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F8FAFD" />
      <SolidColorBrush x:Key="PaneSurfaceBrush" Color="#F3F6FA" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F8FC" />
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#EEF2F7" />
      <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E7EDF5" />
      <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#DDE6F0" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="#5C0D1B2A" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8" />
      <SolidColorBrush x:Key="PaneDividerBrush" Color="#CBD5E1" />
