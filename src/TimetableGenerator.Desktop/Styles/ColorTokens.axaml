      <SolidColorBrush x:Key="ProductDangerActionPressedFillBrush" Color="#82071E" />
      <SolidColorBrush x:Key="ProductOnDangerActionFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PreferencePreferredFillBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="PreferencePreferredBorderBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="PreferencePreferredForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PreferenceAcceptableFillBrush" Color="#DDF4FF" />
