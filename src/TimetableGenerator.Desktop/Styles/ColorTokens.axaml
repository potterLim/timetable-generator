      <SolidColorBrush x:Key="CourseGreenBackgroundBrush" Color="#DAFBE1" />
      <SolidColorBrush x:Key="CourseGreenBorderBrush" Color="#397A59" />
      <SolidColorBrush x:Key="PersonalScheduleBackgroundBrush" Color="#EEF2FF" />
