      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B949E" />
      <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#79B8FF" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#388BFD" />
      <SolidColorBrush x:Key="AccentTintBrush" Color="#1C2D41" />
      <SolidColorBrush x:Key="ProductPrimaryActionFillBrush" Color="#1D5FBF" />
      <SolidColorBrush x:Key="ProductPrimaryActionHoverFillBrush" Color="#2468C9" />
