<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ScheduleWorkspaceView"
    x:Name="WorkspaceRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    Background="{DynamicResource WindowBackgroundBrush}"
    AutomationProperties.LandmarkType="Main"
    AutomationProperties.Name="추천 시간표">
  <UserControl.Styles>
    <Style Selector="TextBlock.export-status.success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.export-status.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="24,20,22,16" RowDefinitions="Auto,14,*,14,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,10,Auto">
      <TextBlock
          Grid.Row="0"
          Grid.Column="0"
          Classes="title"
          AutomationProperties.HeadingLevel="1"
          Text="추천 시간표" />

      <StackPanel
          Grid.Row="2"
          Grid.Column="0"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            Classes="outline"
            IsVisible="{Binding IsCoursePaneToggleVisible}"
            Command="{Binding ToggleCoursePaneCommand}"
            AutomationProperties.Name="과목 찾기 패널 열기">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon Icon="PanelLeft" IconVariant="Regular" FontSize="17" />
            <TextBlock VerticalAlignment="Center" Text="과목 찾기" />
          </StackPanel>
        </Button>
        <Button
            Classes="outline"
            IsVisible="{Binding IsInspectorPaneToggleVisible}"
            Command="{Binding ToggleInspectorPaneCommand}"
            AutomationProperties.Name="내 계획 패널 열기">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon Icon="PanelRight" IconVariant="Regular" FontSize="17" />
            <TextBlock VerticalAlignment="Center" Text="내 계획" />
          </StackPanel>
        </Button>
        <TextBlock
            VerticalAlignment="Center"
            Foreground="{DynamicResource AccentBrush}"
            FontWeight="SemiBold"
            IsVisible="{Binding HasScheduleEntries}"
            Text="{Binding RecommendationInsight}" />
      </StackPanel>

      <StackPanel
          x:Name="RecommendationActions"
          Grid.Row="0"
          Grid.RowSpan="3"
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="10"
          IsVisible="{Binding HasScheduleEntries}"
          VerticalAlignment="Center">
        <Button
            Classes="outline"
            Width="40"
            Padding="8"
            Command="{Binding PreviousRecommendationCommand}"
            AutomationProperties.AutomationId="PreviousRecommendation"
            AutomationProperties.Name="이전 추천 시간표"
            ToolTip.Tip="이전 시간표">
          <icons:FluentIcon Icon="ChevronLeft" IconVariant="Regular" FontSize="19" />
        </Button>
        <TextBlock
            MinWidth="62"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            FontWeight="SemiBold"
            Text="{Binding RecommendationSummary}"
            AutomationProperties.LiveSetting="Polite" />
        <Button
            Classes="outline"
            Width="40"
            Padding="8"
            Command="{Binding NextRecommendationCommand}"
            AutomationProperties.AutomationId="NextRecommendation"
            AutomationProperties.Name="다음 추천 시간표"
            ToolTip.Tip="다음 시간표">
          <icons:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="19" />
        </Button>
        <Button
            x:Name="ExportScheduleButton"
            Classes="accent"
            Margin="4,0,0,0"
            IsEnabled="{Binding HasScheduleEntries}"
            Command="{Binding ExportCommand, ElementName=WorkspaceRoot}"
            AutomationProperties.AutomationId="ExportSchedule"
            AutomationProperties.Name="현재 시간표를 PNG로 저장"
            AutomationProperties.HelpText="현재 추천 시간표를 고해상도 PNG 파일로 저장합니다."
            ToolTip.Tip="PNG로 저장">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:FluentIcon Icon="Save" IconVariant="Regular" FontSize="18" />
            <TextBlock VerticalAlignment="Center" Text="PNG로 저장" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid
          x:Name="ScheduleBoardContainer"
          IsVisible="{Binding HasScheduleEntries}">
        <views:ScheduleBoardView
            x:Name="ScheduleBoard"
            DataContext="{Binding ActiveRecommendation}" />
      </Grid>

      <Border
          x:Name="ScheduleEmptyState"
          Padding="32"
          IsVisible="{Binding IsScheduleEmpty}"
          Background="Transparent">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
          <Border
              Width="46"
              Height="46"
              HorizontalAlignment="Center"
              Background="{DynamicResource AccentTintBrush}"
              CornerRadius="23">
            <icons:FluentIcon
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="CalendarEmpty"
                IconVariant="Regular"
                Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <TextBlock
              Margin="0,4,0,0"
              FontSize="20"
              FontWeight="SemiBold"
              Text="{Binding EmptyScheduleTitle}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <TextBlock
              Classes="secondary"
              LineHeight="21"
              Text="{Binding EmptyScheduleMessage}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border
          Padding="32"
          IsVisible="{Binding IsRecommendationCalculating}"
          Background="Transparent"
          AutomationProperties.LiveSetting="Polite">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
          <ProgressBar
              Width="180"
              Height="4"
              IsIndeterminate="True" />
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="가능한 시간표를 계산하고 있어요"
              TextAlignment="Center" />
          <TextBlock
              Classes="secondary"
              Text="과목 수와 분반 조합에 따라 잠시 걸릴 수 있습니다. 앱의 다른 기능은 계속 사용할 수 있어요."
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border
          Padding="32"
          IsVisible="{Binding HasRecommendationCalculationError}"
          Background="Transparent"
          AutomationProperties.LiveSetting="Assertive">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
          <icons:FluentIcon
              Width="28"
              Height="28"
              HorizontalAlignment="Center"
              Icon="Warning"
              IconVariant="Regular"
              Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="추천 시간표를 계산하지 못했어요"
              TextAlignment="Center" />
          <TextBlock
              Classes="secondary"
              Text="{Binding RecommendationCalculationError}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              Classes="accent"
              HorizontalAlignment="Center"
              Command="{Binding RetryRecommendationCommand}"
              Content="다시 계산" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel
        x:Name="RecommendationFooter"
        Grid.Row="4"
        Orientation="Horizontal"
        Spacing="8"
        IsVisible="{Binding HasScheduleEntries}"
        VerticalAlignment="Center">
      <icons:FluentIcon
          Width="18"
          Height="18"
          Icon="Lightbulb"
          IconVariant="Regular"
          Foreground="{DynamicResource AccentBrush}" />
      <TextBlock
          x:Name="ExportStatusText"
          Classes="caption export-status"
          IsVisible="False"
          AutomationProperties.LiveSetting="Polite" />
      <TextBlock
          Classes="caption"
          Text="원하는 과목을 추가하거나 제거해 더 많은 시간표를 추천받으세요." />
    </StackPanel>
  </Grid>
</UserControl>
