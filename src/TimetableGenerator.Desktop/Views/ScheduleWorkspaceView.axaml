<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ScheduleWorkspaceView"
    x:Name="WorkspaceRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    Background="{DynamicResource WorkspaceBackdropBrush}"
    AutomationProperties.LandmarkType="Main"
    AutomationProperties.Name="시간표 작업 영역">
  <UserControl.Styles>
    <Style Selector="TextBlock.export-status.success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.export-status.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.export-status-toast.success">
      <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.export-status-toast.error">
      <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="18,18,18,16" RowDefinitions="40,14,*">
    <Grid
        x:Name="WorkspaceCommandBar"
        Grid.Row="0"
        Height="40"
        ColumnDefinitions="Auto,*,Auto">
      <StackPanel
          x:Name="WorkspaceSupportingActions"
          Grid.Column="0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            x:Name="OpenCoursePaneButton"
            Classes="outline"
            IsVisible="{Binding IsCoursePaneToggleVisible}"
            Command="{Binding ToggleCoursePaneCommand}"
            AutomationProperties.Name="과목 찾기 패널 열기">
          <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon Icon="PanelLeft" IconVariant="Regular" FontSize="17" />
            <TextBlock VerticalAlignment="Center" Text="과목 찾기" />
          </StackPanel>
        </Button>
        <Button
            x:Name="ScheduleViewModeButton"
            Classes="outline"
            IsVisible="{Binding HasScheduleEntries}"
            Command="{Binding ToggleSchedulePresentationCommand, ElementName=WorkspaceRoot}"
            AutomationProperties.Name="시간표를 목록으로 보기"
            ToolTip.Tip="목록으로 보기">
          <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon
                x:Name="ScheduleViewModeIcon"
                Icon="List"
                IconVariant="Regular"
                FontSize="17" />
            <TextBlock
                x:Name="ScheduleViewModeText"
                VerticalAlignment="Center"
                Text="목록 보기" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel
          x:Name="WorkspaceHeaderActions"
          Grid.Column="2"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="10"
          VerticalAlignment="Center">
        <StackPanel
            x:Name="RecommendationActions"
            Orientation="Horizontal"
            Spacing="10"
            IsVisible="{Binding HasMultipleRecommendations}">
          <Button
              Classes="outline"
              Width="40"
              Padding="8"
              Command="{Binding PreviousRecommendationCommand}"
              AutomationProperties.AutomationId="PreviousRecommendation"
              AutomationProperties.Name="이전 추천 시간표"
              ToolTip.Tip="이전 시간표">
            <icons:FluentIcon Icon="ChevronLeft" IconVariant="Regular" FontSize="19" />
          </Button>
          <TextBlock
              MinWidth="62"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              TextAlignment="Center"
              FontWeight="SemiBold"
              Text="{Binding RecommendationSummary}"
              AutomationProperties.LiveSetting="Polite" />
          <Button
              Classes="outline"
              Width="40"
              Padding="8"
              Command="{Binding NextRecommendationCommand}"
              AutomationProperties.AutomationId="NextRecommendation"
              AutomationProperties.Name="다음 추천 시간표"
              ToolTip.Tip="다음 시간표">
            <icons:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="19" />
          </Button>
        </StackPanel>
        <Button
            x:Name="WorkspaceAddPersonalScheduleButton"
            Classes="outline"
            Command="{Binding BeginAddPersonalScheduleCommand}"
            AutomationProperties.Name="개인 일정 추가"
            ToolTip.Tip="개인 일정 추가">
          <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="17" />
            <TextBlock VerticalAlignment="Center" Text="일정 추가" />
          </StackPanel>
        </Button>
        <Button
            x:Name="OpenInspectorPaneButton"
            Classes="outline"
            IsVisible="{Binding IsInspectorPaneToggleVisible}"
            Command="{Binding ToggleInspectorPaneCommand}"
            AutomationProperties.AutomationId="OpenInspectorPane"
            AutomationProperties.Name="내 계획 패널 열기"
            ToolTip.Tip="내 계획 열기">
          <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
            <icons:FluentIcon Icon="PanelRight" IconVariant="Regular" FontSize="17" />
            <TextBlock VerticalAlignment="Center" Text="내 계획 열기" />
          </StackPanel>
        </Button>
        <Button
            x:Name="ExportScheduleButton"
            Classes="accent"
            IsVisible="{Binding CanExportSchedule}"
            IsEnabled="{Binding CanExportSchedule}"
            Command="{Binding ExportCommand, ElementName=WorkspaceRoot}"
            AutomationProperties.AutomationId="ExportSchedule"
            AutomationProperties.Name="현재 시간표를 PNG로 저장"
            AutomationProperties.HelpText="현재 시간표를 고해상도 PNG 파일로 저장합니다."
            ToolTip.Tip="PNG로 저장">
          <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="8">
            <icons:FluentIcon Icon="Save" IconVariant="Regular" FontSize="18" />
            <TextBlock VerticalAlignment="Center" Text="PNG로 저장" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <Border
          x:Name="UnsatisfiedPersonalScheduleBanner"
          Grid.Row="0"
          Margin="0,0,0,12"
          Padding="14,11"
          IsVisible="{Binding HasUnsatisfiedPersonalSchedulePreview}"
          Background="{DynamicResource WarningSubtleBrush}"
          CornerRadius="7"
          AutomationProperties.LiveSetting="Polite">
        <Grid ColumnDefinitions="Auto,12,*,16,Auto">
          <icons:FluentIcon
              Grid.Column="0"
              Width="20"
              Height="20"
              VerticalAlignment="Center"
              Icon="Warning"
              IconVariant="Regular"
              Foreground="{DynamicResource WarningBrush}" />
          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
            <TextBlock
                FontWeight="SemiBold"
                Text="과목은 배치하지 못했습니다" />
            <TextBlock
                Classes="caption"
                Text="아래에는 개인 일정만 표시됩니다. 겹치는 일정이나 분반 선택을 조정해 보세요."
                TextWrapping="Wrap" />
          </StackPanel>
          <Button
              Grid.Column="4"
              Classes="outline"
              VerticalAlignment="Center"
              Command="{Binding OpenInspectorPaneCommand}"
              Content="내 계획 확인"
              AutomationProperties.Name="충돌한 과목 선택을 내 계획에서 확인" />
        </Grid>
      </Border>

      <Grid
          x:Name="ScheduleBoardContainer"
          Grid.Row="1"
          IsVisible="{Binding HasScheduleEntries}">
        <views:ScheduleBoardView
            x:Name="ScheduleBoard"
            EditPersonalScheduleCommand="{Binding EditPersonalScheduleCommand, ElementName=WorkspaceRoot}"
            DataContext="{Binding DisplayedScheduleBoard}" />
        <Border
            x:Name="ScheduleListContainer"
            IsVisible="False"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.Name="시간표 목록">
          <Grid RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Margin="18,14"
                ColumnDefinitions="*,Auto">
              <TextBlock
                  AutomationProperties.HeadingLevel="2"
                  FontSize="17"
                  FontWeight="SemiBold"
                  Text="주간 일정 목록" />
              <TextBlock
                  Grid.Column="1"
                  Classes="caption"
                  VerticalAlignment="Center"
                  Text="요일과 시간순" />
            </Grid>
            <ScrollViewer
                x:Name="ScheduleListScrollViewer"
                Grid.Row="1"
                Margin="0,0,7,7"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <ListBox
                  x:Name="ScheduleListItems"
                  Classes="workspace-list"
                  Margin="12,0,5,5"
                  ItemsSource="{Binding DisplayedScheduleBoard.ListGroups}">
                <ListBox.Styles>
                  <Style
                      Selector="ListBoxItem"
                      x:DataType="models:ScheduleListGroup">
                    <Setter
                        Property="AutomationProperties.Name"
                        Value="{Binding AccessibleName}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ScheduleListGroup">
                    <Border
                        Padding="16,14"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid ColumnDefinitions="260,20,*">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            LineHeight="21"
                            MaxLines="2"
                            Text="{Binding TitleDisplayText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Border
                            Grid.Column="1"
                            Width="1"
                            MinHeight="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}" />
                        <ItemsControl
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Occurrences}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ScheduleListOccurrence">
                              <Grid
                                  MinHeight="24"
                                  ColumnDefinitions="164,*"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    LineHeight="20"
                                    Text="{Binding ScheduleDisplayText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="caption"
                                    IsVisible="{Binding HasMetadata}"
                                    LineHeight="20"
                                    Text="{Binding MetadataDisplayText}"
                                    TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border
          x:Name="ScheduleEmptyState"
          Grid.Row="0"
          Grid.RowSpan="2"
          Padding="32"
          IsVisible="{Binding IsScheduleEmpty}"
          Background="Transparent">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
          <Border
              Width="46"
              Height="46"
              HorizontalAlignment="Center"
              Background="{DynamicResource AccentTintBrush}"
              CornerRadius="23">
            <icons:FluentIcon
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="CalendarEmpty"
                IconVariant="Regular"
                Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <TextBlock
              Margin="0,4,0,0"
              FontSize="20"
              FontWeight="SemiBold"
              Text="{Binding EmptyScheduleTitle}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <TextBlock
              Classes="secondary"
              Text="{Binding EmptyScheduleMessage}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              x:Name="EmptyScheduleAddPersonalScheduleButton"
              Classes="outline"
              Margin="0,6,0,0"
              HorizontalAlignment="Center"
              Command="{Binding BeginAddPersonalScheduleCommand}"
              AutomationProperties.Name="빈 시간표에 개인 일정 추가">
            <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
              <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="17" />
              <TextBlock Text="개인 일정 추가" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border
          x:Name="UnsatisfiedScheduleEmptyState"
          Grid.Row="0"
          Grid.RowSpan="2"
          Padding="32"
          IsVisible="{Binding IsUnsatisfiedScheduleEmpty}"
          Background="Transparent"
          AutomationProperties.LiveSetting="Polite">
        <StackPanel
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
          <Border
              Width="46"
              Height="46"
              HorizontalAlignment="Center"
              Background="{DynamicResource WarningSubtleBrush}"
              CornerRadius="23">
            <icons:FluentIcon
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="Warning"
                IconVariant="Regular"
                Foreground="{DynamicResource WarningBrush}" />
          </Border>
          <TextBlock
              Margin="0,4,0,0"
              FontSize="20"
              FontWeight="SemiBold"
              Text="현재 선택으로 만들 수 있는 시간표가 없습니다"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <TextBlock
              Classes="secondary"
              Text="겹치는 일정이나 제외한 분반을 확인해 보세요."
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              x:Name="UnsatisfiedScheduleOpenPlanButton"
              Classes="outline"
              Margin="0,6,0,0"
              HorizontalAlignment="Center"
              Command="{Binding OpenInspectorPaneCommand}"
              AutomationProperties.Name="충돌한 과목 선택을 내 계획에서 확인">
            <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
              <icons:FluentIcon Icon="PanelRight" IconVariant="Regular" FontSize="17" />
              <TextBlock Text="내 계획 확인" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border
          Grid.Row="0"
          Grid.RowSpan="2"
          Padding="32"
          IsVisible="{Binding IsRecommendationCalculating}"
          Background="Transparent"
          AutomationProperties.LiveSetting="Polite">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
          <ProgressBar
              Width="180"
              Height="4"
              IsIndeterminate="True" />
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="가능한 시간표 계산 중"
              TextAlignment="Center" />
          <TextBlock
              Classes="secondary"
              Text="분반 조합이 많으면 잠시 걸릴 수 있습니다."
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border
          Grid.Row="0"
          Grid.RowSpan="2"
          Padding="32"
          IsVisible="{Binding HasRecommendationCalculationError}"
          Background="Transparent"
          AutomationProperties.LiveSetting="Assertive">
        <StackPanel
            MaxWidth="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
          <icons:FluentIcon
              Width="28"
              Height="28"
              HorizontalAlignment="Center"
              Icon="Warning"
              IconVariant="Regular"
              Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="추천 시간표를 계산하지 못했습니다"
              TextAlignment="Center" />
          <TextBlock
              Classes="secondary"
              Text="{Binding RecommendationCalculationError}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              Classes="accent"
              HorizontalAlignment="Center"
              Command="{Binding RetryRecommendationCommand}"
              Content="다시 계산" />
        </StackPanel>
      </Border>
    </Grid>

    <Border
        x:Name="ExportStatusToast"
        Grid.Row="2"
        Classes="export-status-toast"
        Margin="0,10,8,0"
        Padding="12,8"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        ZIndex="20"
        IsHitTestVisible="False"
        IsVisible="False"
        BorderThickness="1"
        CornerRadius="7">
      <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="7">
        <icons:FluentIcon
            x:Name="ExportStatusIcon"
            Width="17"
            Height="17"
            VerticalAlignment="Center"
            Icon="CheckmarkCircle"
            IconVariant="Regular" />
        <TextBlock
            x:Name="ExportStatusText"
            Classes="caption export-status"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>

    <Canvas
        x:Name="PngExportHost"
        Grid.Row="0"
        Grid.RowSpan="3"
        ZIndex="-1"
        IsHitTestVisible="False"
        Opacity="0" />
  </Grid>
</UserControl>
