<Window
    x:Class="TimetableGenerator.Desktop.Views.MainWindow"
    x:Name="ProductWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:product="using:TimetableGenerator.Desktop.Product"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="product:ProductShellViewModel"
    MinWidth="900"
    MinHeight="640"
    Title="시간표"
    Icon="/Assets/AppIcon.png"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="56"
    ShowInTaskbar="True"
    WindowDecorationsTheme="{StaticResource ProductWindowDecorationsTheme}"
    WindowStartupLocation="CenterScreen"
    AutomationProperties.Name="{Binding AccessibleWindowName}">
  <Grid
      RowDefinitions="56,*"
      Background="{DynamicResource WindowBackgroundBrush}">
    <Border
        x:Name="ProductTitleBar"
        Grid.Row="0"
        Padding="{DynamicResource WindowTitleBarContentPadding}"
        Background="{DynamicResource ChromeSurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Banner"
        WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Grid
            Grid.Column="0"
            ColumnDefinitions="28,Auto"
            ColumnSpacing="12"
            VerticalAlignment="Center">
          <Border
              Grid.Column="0"
              Width="28"
              Height="28"
              Background="{DynamicResource BrandMarkBackgroundBrush}"
              BorderBrush="{DynamicResource BrandMarkBorderBrush}"
              BorderThickness="1"
              ClipToBounds="True"
              CornerRadius="3">
            <Image
                Width="68"
                Height="68"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/AppIcon.png"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False" />
          </Border>
          <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="0">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                LineHeight="19"
                Text="시간표" />
            <TextBlock
                Classes="caption"
                IsVisible="{Binding IsReady}"
                LineHeight="16"
                Text="{Binding WorkspaceOrNull.InstitutionTermDisplayText}" />
          </StackPanel>
        </Grid>

        <Button
            x:Name="AppearanceButton"
            Grid.Column="2"
            Classes="icon"
            Margin="0,0,8,0"
            AutomationProperties.Name="화면 모드 설정"
            ToolTip.Tip="화면 모드"
            WindowDecorationProperties.ElementRole="User">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <views:AppearanceSettingsView
                  DataContext="{Binding #ProductWindow.Appearance}" />
            </Flyout>
          </Button.Flyout>
          <Grid>
            <icons:FluentIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="Desktop"
                IconVariant="Regular"
                FontSize="20"
                IsVisible="{Binding #ProductWindow.Appearance.IsSystemThemeSelected}" />
            <icons:FluentIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="WeatherSunny"
                IconVariant="Regular"
                FontSize="20"
                IsVisible="{Binding #ProductWindow.Appearance.IsLightThemeSelected}" />
            <icons:FluentIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="WeatherMoon"
                IconVariant="Regular"
                FontSize="20"
                IsVisible="{Binding #ProductWindow.Appearance.IsDarkThemeSelected}" />
          </Grid>
        </Button>

        <StackPanel
            x:Name="ProductCaptionButtons"
            Grid.Column="3"
            Height="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
            Orientation="Horizontal"
            Spacing="2">
          <Button
              x:Name="WindowMinimizeButton"
              Classes="caption-button"
              Theme="{StaticResource ProductCaptionButtonTheme}"
              IsEnabled="{Binding #ProductWindow.CanMinimize}"
              Click="onWindowMinimizeButtonClick"
              AutomationProperties.AutomationId="WindowMinimizeButton"
              AutomationProperties.Name="최소화"
              ToolTip.Tip="최소화"
              WindowDecorationProperties.ElementRole="MinimizeButton">
            <icons:FluentIcon
                Icon="Subtract"
                IconVariant="Regular"
                FontSize="12"
                AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <Button
              x:Name="WindowMaximizeRestoreButton"
              Classes="caption-button"
              Theme="{StaticResource ProductCaptionButtonTheme}"
              IsEnabled="{Binding #ProductWindow.CanMaximize}"
              Click="onWindowMaximizeRestoreButtonClick"
              AutomationProperties.AutomationId="WindowMaximizeRestoreButton"
              AutomationProperties.Name="최대화"
              ToolTip.Tip="최대화"
              WindowDecorationProperties.ElementRole="MaximizeButton">
            <icons:FluentIcon
                x:Name="WindowMaximizeRestoreIcon"
                Icon="Square"
                IconVariant="Regular"
                FontSize="11"
                AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <Button
              x:Name="WindowCloseButton"
              Classes="caption-button caption-close-button"
              Theme="{StaticResource ProductCaptionButtonTheme}"
              Click="onWindowCloseButtonClick"
              AutomationProperties.AutomationId="WindowCloseButton"
              AutomationProperties.Name="닫기"
              ToolTip.Tip="닫기"
              WindowDecorationProperties.ElementRole="CloseButton">
            <icons:FluentIcon
                Icon="Dismiss"
                IconVariant="Regular"
                FontSize="12"
                AutomationProperties.AccessibilityView="Raw" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid
          x:Name="ProductInteractionSurface"
          IsEnabled="{Binding IsProductInteractionEnabled}">
        <ContentControl
            Content="{Binding WorkspaceOrNull}"
            IsVisible="{Binding IsReady}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="viewModels:PlannerWorkspaceViewModel">
              <views:ProductWorkspaceHostView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <Grid IsVisible="{Binding IsStartupVisible}">
          <Border
              Width="520"
              MaxWidth="520"
              Margin="28"
              Padding="42"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
            <Grid>
              <StackPanel
                  IsVisible="{Binding IsLoading}"
                  Spacing="14"
                  AutomationProperties.LiveSetting="Polite">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding StatusTitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="secondary"
                    FontSize="14"
                    LineHeight="22"
                    Text="{Binding StatusMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Margin="0,12,0,0"
                    Height="4"
                    IsIndeterminate="True"
                    AutomationProperties.Name="시간표 준비 진행 상태" />
              </StackPanel>

              <StackPanel
                  IsVisible="{Binding HasError}"
                  HorizontalAlignment="Stretch"
                  Spacing="14"
                  AutomationProperties.LiveSetting="Assertive">
                <Border
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource WarningSubtleBrush}"
                    CornerRadius="24">
                  <icons:FluentIcon
                      Width="24"
                      Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Icon="ErrorCircle"
                      IconVariant="Regular"
                      Foreground="{DynamicResource WarningBrush}" />
                </Border>
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding StatusTitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="secondary"
                    FontSize="14"
                    LineHeight="22"
                    Text="{Binding StatusMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Classes="accent"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding RetryCommand}"
                    AutomationProperties.Name="과목 데이터 다시 불러오기">
                  <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="8">
                    <icons:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" FontSize="18" />
                    <TextBlock VerticalAlignment="Center" Text="다시 시도" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border
          ZIndex="8"
          MaxWidth="620"
          Margin="24,24,24,28"
          Padding="14,10,10,10"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          IsVisible="{Binding HasProductNotice}"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          BoxShadow="{DynamicResource ToastBoxShadow}"
          CornerRadius="8"
          AutomationProperties.LiveSetting="Polite">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border
              Grid.Column="0"
              Width="30"
              Height="30"
              Background="{DynamicResource AccentTintBrush}"
              CornerRadius="15">
            <icons:FluentIcon
                Width="17"
                Height="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="Info"
                IconVariant="Regular"
                Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="13"
              LineHeight="19"
              Text="{Binding ProductNotice}"
              TextWrapping="Wrap" />
          <Button
              Grid.Column="2"
              Classes="subtle icon"
              Width="30"
              Height="30"
              Padding="0"
              Command="{Binding DismissProductNoticeCommand}"
              AutomationProperties.Name="알림 닫기">
            <icons:FluentIcon
                Icon="Dismiss"
                IconVariant="Regular"
                FontSize="16" />
          </Button>
        </Grid>
      </Border>

      <Border
          x:Name="ShutdownOverlay"
          ZIndex="10"
          IsVisible="{Binding IsShutdownOverlayVisible}"
          Background="{DynamicResource OverlayScrimBrush}"
          AutomationProperties.LiveSetting="Assertive">
        <Border
            x:Name="ShutdownDialog"
            Width="440"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource DialogBoxShadow}"
            CornerRadius="12"
            KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel Spacing="14">
            <ProgressBar
                Height="4"
                IsIndeterminate="True"
                IsVisible="{Binding IsShutdownInProgress}" />
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                IsVisible="{Binding HasShutdownError}"
                Background="{DynamicResource WarningSubtleBrush}"
                CornerRadius="22">
              <icons:FluentIcon
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="Warning"
                  IconVariant="Regular"
                  Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock
                FontSize="21"
                FontWeight="SemiBold"
                Text="{Binding ShutdownTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="{Binding ShutdownMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="ContinueEditingButton"
                Classes="accent"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                IsVisible="{Binding HasShutdownError}"
                Command="{Binding DismissShutdownErrorCommand}"
                Content="계속 편집" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <Border
        x:Name="WindowResizeNorth"
        Grid.RowSpan="2"
        ZIndex="1000"
        Height="6"
        Margin="10,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeN" />
    <Border
        x:Name="WindowResizeSouth"
        Grid.RowSpan="2"
        ZIndex="1000"
        Height="6"
        Margin="10,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeS" />
    <Border
        x:Name="WindowResizeEast"
        Grid.RowSpan="2"
        ZIndex="1000"
        Width="6"
        Margin="0,10"
        HorizontalAlignment="Right"
        VerticalAlignment="Stretch"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeE" />
    <Border
        x:Name="WindowResizeWest"
        Grid.RowSpan="2"
        ZIndex="1000"
        Width="6"
        Margin="0,10"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeW" />
    <Border
        x:Name="WindowResizeNorthEast"
        Grid.RowSpan="2"
        ZIndex="1001"
        Width="12"
        Height="12"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeNE" />
    <Border
        x:Name="WindowResizeNorthWest"
        Grid.RowSpan="2"
        ZIndex="1001"
        Width="12"
        Height="12"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeNW" />
    <Border
        x:Name="WindowResizeSouthEast"
        Grid.RowSpan="2"
        ZIndex="1001"
        Width="12"
        Height="12"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeSE" />
    <Border
        x:Name="WindowResizeSouthWest"
        Grid.RowSpan="2"
        ZIndex="1001"
        Width="12"
        Height="12"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Background="Transparent"
        IsVisible="{Binding #ProductWindow.UsesProductCaptionControls}"
        AutomationProperties.AccessibilityView="Raw"
        WindowDecorationProperties.ElementRole="ResizeSW" />
  </Grid>
</Window>
