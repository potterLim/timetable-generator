<Window
    x:Class="TimetableGenerator.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:product="using:TimetableGenerator.Desktop.Product"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="product:ProductShellViewModel"
    Width="1440"
    Height="900"
    MinWidth="900"
    MinHeight="640"
    Title="시간표"
    Icon="/Assets/AppIcon.png"
    WindowStartupLocation="CenterScreen"
    AutomationProperties.Name="{Binding AccessibleWindowName}">
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid IsEnabled="{Binding IsProductInteractionEnabled}">
    <ContentControl
        Content="{Binding WorkspaceOrNull}"
        IsVisible="{Binding IsReady}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="viewModels:PlannerWorkspaceViewModel">
          <views:ProductWorkspaceHostView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <Grid
        IsVisible="{Binding IsStartupVisible}"
        RowDefinitions="64,*">
      <Border
          Grid.Row="0"
          Padding="28,0"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="30,Auto" ColumnSpacing="14" VerticalAlignment="Center">
          <Border
              Grid.Column="0"
              Width="30"
              Height="30"
              ClipToBounds="True">
            <Image
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/AppIcon.png"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False" />
          </Border>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="20"
              FontWeight="SemiBold"
              Text="시간표" />
        </Grid>
      </Border>

      <Border
          Grid.Row="1"
          Width="520"
          MaxWidth="520"
          Margin="28"
          Padding="42"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
        <Grid>
          <StackPanel
              IsVisible="{Binding IsLoading}"
              Spacing="14"
              AutomationProperties.LiveSetting="Polite">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding StatusTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="secondary"
                FontSize="14"
                LineHeight="22"
                Text="{Binding StatusMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ProgressBar
                Margin="0,12,0,0"
                Height="4"
                IsIndeterminate="True"
                AutomationProperties.Name="시간표 준비 진행 상태" />
          </StackPanel>

          <StackPanel
              IsVisible="{Binding HasError}"
              HorizontalAlignment="Stretch"
              Spacing="14"
              AutomationProperties.LiveSetting="Assertive">
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                Background="{DynamicResource WarningSubtleBrush}"
                CornerRadius="24">
              <icons:FluentIcon
                  Width="24"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="ErrorCircle"
                  IconVariant="Regular"
                  Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding StatusTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="secondary"
                FontSize="14"
                LineHeight="22"
                Text="{Binding StatusMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Classes="accent"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding RetryCommand}"
                AutomationProperties.Name="과목 데이터 다시 불러오기">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" FontSize="18" />
                <TextBlock VerticalAlignment="Center" Text="다시 시도" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    </Grid>

    <Border
        ZIndex="10"
        IsVisible="{Binding IsShutdownOverlayVisible}"
        Background="{DynamicResource OverlayScrimBrush}"
        AutomationProperties.LiveSetting="Assertive">
      <Border
          Width="440"
          Padding="32"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
        <StackPanel Spacing="14">
          <ProgressBar
              Height="4"
              IsIndeterminate="True"
              IsVisible="{Binding IsShutdownInProgress}" />
          <Border
              Width="44"
              Height="44"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasShutdownError}"
              Background="{DynamicResource WarningSubtleBrush}"
              CornerRadius="22">
            <icons:FluentIcon
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="Warning"
                IconVariant="Regular"
                Foreground="{DynamicResource WarningBrush}" />
          </Border>
          <TextBlock
              FontSize="21"
              FontWeight="SemiBold"
              Text="{Binding ShutdownTitle}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <TextBlock
              Classes="secondary"
              LineHeight="21"
              Text="{Binding ShutdownMessage}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              Classes="accent"
              Margin="0,6,0,0"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasShutdownError}"
              Command="{Binding DismissShutdownErrorCommand}"
              Content="계속 편집" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
