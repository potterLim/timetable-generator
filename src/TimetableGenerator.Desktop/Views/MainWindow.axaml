<Window
    x:Class="TimetableGenerator.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    Width="1440"
    Height="900"
    MinWidth="900"
    MinHeight="640"
    Title="시간표"
    Icon="/Assets/AppIcon.png"
    WindowStartupLocation="CenterScreen"
    AutomationProperties.Name="한동대학교 시간표 계획">
  <Grid RowDefinitions="64,48,*">
    <Border
        Grid.Row="0"
        Padding="28,0,22,0"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Banner">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Grid Grid.Column="0" ColumnDefinitions="30,Auto" ColumnSpacing="14">
          <Border
              Grid.Column="0"
              Width="30"
              Height="30"
              ClipToBounds="True">
            <Image
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/AppIcon.png"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False" />
          </Border>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="20"
              FontWeight="SemiBold"
              Text="시간표" />
        </Grid>

        <Border
            Grid.Column="1"
            Width="1"
            Height="24"
            Margin="24,0"
            Background="{DynamicResource BorderBrush}" />

        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="15"
            FontWeight="SemiBold"
            Text="한동대학교  ·  2026-2" />

        <StackPanel
            Grid.Column="3"
            Margin="28,0,0,0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            AutomationProperties.Name="자동 저장 상태"
            AutomationProperties.LiveSetting="Polite">
          <icons:FluentIcon
              Width="18"
              Height="18"
              Icon="CheckmarkCircle"
              IconVariant="Regular"
              Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock
              VerticalAlignment="Center"
              Foreground="{DynamicResource SuccessBrush}"
              Text="자동 저장됨" />
        </StackPanel>

        <Button
            Grid.Column="4"
            Classes="icon"
            Margin="0,0,10,0"
            AutomationProperties.Name="도움말"
            ToolTip.Tip="도움말">
          <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" FontSize="21" />
        </Button>

        <Button
            Grid.Column="5"
            Classes="icon"
            AutomationProperties.Name="설정"
            ToolTip.Tip="설정">
          <icons:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="21" />
        </Button>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Navigation">
      <Grid ColumnDefinitions="Auto,1,Auto" HorizontalAlignment="Left">
        <TabStrip
            Grid.Column="0"
            Classes="plan-tabs"
            ItemsSource="{Binding Plans}"
            SelectedItem="{Binding ActivePlan, Mode=TwoWay}"
            AutomationProperties.Name="계획 목록">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="models:PlanTabItem">
              <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>

        <Border
            Grid.Column="1"
            Width="1"
            Height="20"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderBrush}" />

        <Button
            Grid.Column="2"
            Classes="icon"
            Margin="12,6"
            Command="{Binding AddPlanCommand}"
            AutomationProperties.Name="새 계획 추가"
            ToolTip.Tip="새 계획 추가">
          <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="20" />
        </Button>
      </Grid>
    </Border>

    <SplitView
        Grid.Row="2"
        PanePlacement="Left"
        DisplayMode="{Binding CoursePaneDisplayMode}"
        IsPaneOpen="{Binding IsCoursePaneOpen, Mode=TwoWay}"
        OpenPaneLength="{Binding CoursePaneWidth}"
        PaneBackground="{DynamicResource SurfaceBrush}"
        UseLightDismissOverlayMode="True">
      <SplitView.Pane>
        <views:CourseBrowserView />
      </SplitView.Pane>

      <SplitView.Content>
        <SplitView
            PanePlacement="Right"
            DisplayMode="{Binding InspectorPaneDisplayMode}"
            IsPaneOpen="{Binding IsInspectorPaneOpen, Mode=TwoWay}"
            OpenPaneLength="{Binding InspectorPaneWidth}"
            PaneBackground="{DynamicResource SurfaceBrush}"
            UseLightDismissOverlayMode="True">
          <SplitView.Pane>
            <views:PlanInspectorView />
          </SplitView.Pane>

          <SplitView.Content>
            <views:ScheduleWorkspaceView />
          </SplitView.Content>
        </SplitView>
      </SplitView.Content>
    </SplitView>
  </Grid>
</Window>
