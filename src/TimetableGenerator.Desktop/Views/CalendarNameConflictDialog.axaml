<Window
    x:Class="TimetableGenerator.Desktop.Views.CalendarNameConflictDialog"
    x:Name="CalendarConflictWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    Width="520"
    SizeToContent="Height"
    MinHeight="250"
    Title="캘린더 내보내기"
    Icon="/Assets/AppIcon.png"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    AutomationProperties.Name="같은 이름의 캘린더 확인">
  <Border Padding="28">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="22">
      <Grid Grid.Row="0" ColumnDefinitions="44,*" ColumnSpacing="14">
        <Border
            Width="44"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentTintBrush}"
            CornerRadius="22">
          <icons:FluentIcon
              Width="22"
              Height="22"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Icon="CalendarArrowRight"
              IconVariant="Regular"
              Foreground="{DynamicResource AccentBrush}"
              AutomationProperties.AccessibilityView="Raw" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="7">
          <TextBlock
              AutomationProperties.HeadingLevel="1"
              FontSize="21"
              FontWeight="SemiBold"
              Text="같은 이름의 캘린더가 있습니다"
              TextWrapping="Wrap" />
          <TextBlock
              x:Name="AvailableNameDescription"
              Classes="secondary"
              LineHeight="21"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <TextBlock
          x:Name="ReplacementUnavailableDescription"
          Grid.Row="1"
          Classes="secondary"
          Margin="58,0,0,0"
          LineHeight="20"
          IsVisible="False"
          Text="이 캘린더는 안전하게 대체할 수 없습니다."
          TextWrapping="Wrap" />

      <StackPanel
          Grid.Row="2"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            x:Name="CancelButton"
            Classes="outline"
            Content="취소"
            Click="onCancelButtonClick"
            AutomationProperties.AutomationId="CancelCalendarNameConflict"
            AutomationProperties.Name="캘린더 내보내기 취소" />
        <Button
            x:Name="ReplaceButton"
            Classes="danger"
            Content="기존 캘린더 대체"
            Click="onReplaceButtonClick"
            AutomationProperties.AutomationId="ReplaceExistingCalendar"
            AutomationProperties.Name="기존 캘린더 대체" />
        <Button
            x:Name="CreateButton"
            Classes="accent"
            Content="새로 만들기"
            Click="onCreateButtonClick"
            AutomationProperties.AutomationId="CreateNumberedCalendar"
            AutomationProperties.Name="번호를 붙여 새 캘린더 만들기" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
