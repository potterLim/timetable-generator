<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ProductWorkspaceHostView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel">
  <UserControl.Styles>
    <Style Selector="SplitView.persistent-inspector /template/ Rectangle#LightDismissLayer">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid
        x:Name="WorkspaceSurface"
        RowDefinitions="44,*"
        IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
    <Border
        Grid.Row="0"
        Background="{DynamicResource ChromeSurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Navigation">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <ScrollViewer
            x:Name="PlanTabScrollViewer"
            Grid.Column="0"
            MaxWidth="720"
            HorizontalAlignment="Left"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
          <TabStrip
              Classes="plan-tabs"
              ItemsSource="{Binding Plans}"
              SelectedItem="{Binding ActivePlan, Mode=TwoWay}"
              AutomationProperties.Name="계획 목록">
            <TabStrip.Styles>
              <Style Selector="TabStripItem">
                <Setter
                    Property="AutomationProperties.Name"
                    Value="{ReflectionBinding DisplayName}" />
              </Style>
            </TabStrip.Styles>
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="models:PlanTabItem">
                <StackPanel
                    x:Name="PlanTabContent"
                    Orientation="Horizontal"
                    Spacing="8">
                  <StackPanel.ContextMenu>
                    <ContextMenu
                        x:DataType="models:PlanTabItem"
                        DataContext="{Binding #PlanTabContent.DataContext}">
                      <MenuItem
                          Header="이름 변경"
                          Command="{Binding RenameCommand}">
                        <MenuItem.Icon>
                          <icons:FluentIcon
                              Icon="Edit"
                              IconVariant="Regular"
                              FontSize="17" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <TextBlock
                      MaxWidth="160"
                      VerticalAlignment="Center"
                      Text="{Binding DisplayName}"
                      TextTrimming="CharacterEllipsis"
                      AutomationProperties.AccessibilityView="Raw"
                      ToolTip.Tip="{Binding DisplayName}" />
                  <Button
                      Classes="subtle icon"
                      Width="32"
                      Height="32"
                      MinWidth="32"
                      MinHeight="32"
                      Padding="0"
                      IsEnabled="{Binding CanClose}"
                      IsVisible="{Binding CanClose}"
                      Command="{Binding CloseCommand}"
                      AutomationProperties.Name="{Binding CloseButtonAccessibleName}"
                      AutomationProperties.HelpText="{Binding CloseButtonHelpText}"
                      ToolTip.Tip="{Binding CloseButtonHelpText}">
                    <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
        </ScrollViewer>

        <Button
            x:Name="AddPlanButton"
            Grid.Column="1"
            Classes="icon"
            Margin="8,4"
            Command="{Binding AddPlanCommand}"
            AutomationProperties.Name="새 계획 추가"
            ToolTip.Tip="새 계획 추가">
          <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="20" />
        </Button>

        <Grid
            Grid.Column="2"
            Margin="12,0,18,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.Name="자동 저장 상태"
            AutomationProperties.LiveSetting="Polite">
          <StackPanel
              Orientation="Horizontal"
              Spacing="8"
              IsVisible="{Binding IsAutosaveSaving}">
            <ProgressBar
                Width="34"
                Height="3"
                VerticalAlignment="Center"
                IsIndeterminate="True" />
            <TextBlock
                Classes="secondary"
                VerticalAlignment="Center"
                Text="{Binding AutosaveStatusText}" />
          </StackPanel>
          <Button
              MinHeight="32"
              Padding="8,4"
              HorizontalAlignment="Right"
              Background="Transparent"
              BorderBrush="Transparent"
              Foreground="{DynamicResource ErrorBrush}"
              IsVisible="{Binding HasAutosaveError}"
              Command="{Binding RetryAutosaveCommand}"
              AutomationProperties.Name="자동 저장 다시 시도"
              ToolTip.Tip="다시 저장">
            <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="8">
              <icons:FluentIcon Icon="ErrorCircle" IconVariant="Regular" FontSize="18" />
              <TextBlock VerticalAlignment="Center" Text="저장 실패: 다시 시도" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <SplitView
        Grid.Row="1"
        PanePlacement="Left"
        DisplayMode="{Binding CoursePaneDisplayMode}"
        IsPaneOpen="{Binding IsCoursePaneOpen, Mode=TwoWay}"
        OpenPaneLength="{Binding CoursePaneWidth}"
        PaneBackground="{DynamicResource PaneSurfaceBrush}"
        UseLightDismissOverlayMode="{Binding IsWorkspaceInteractionEnabled}">
      <SplitView.Pane>
        <views:CourseBrowserView />
      </SplitView.Pane>

      <SplitView.Content>
        <SplitView
            x:Name="InspectorSplitView"
            Classes="persistent-inspector"
            PanePlacement="Right"
            DisplayMode="{Binding InspectorPaneDisplayMode}"
            IsPaneOpen="{Binding IsInspectorPaneOpen, Mode=TwoWay}"
            OpenPaneLength="{Binding InspectorPaneWidth}"
            PaneBackground="{DynamicResource PaneSurfaceBrush}"
            UseLightDismissOverlayMode="False"
            PaneClosing="onInspectorPaneClosing">
          <SplitView.Pane>
            <views:PlanInspectorView />
          </SplitView.Pane>

          <SplitView.Content>
            <views:ScheduleWorkspaceView />
          </SplitView.Content>
        </SplitView>
      </SplitView.Content>
    </SplitView>
    </Grid>

    <Border
        x:Name="PlanEditingOverlay"
        ZIndex="12"
        IsVisible="{Binding IsPlanEditingOverlayVisible}"
        Background="{DynamicResource OverlayScrimBrush}"
        AutomationProperties.LiveSetting="Assertive">
      <Border
          x:Name="PlanEditingDialog"
          MaxWidth="440"
          Margin="16"
          Padding="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          BoxShadow="0 18 48 0 #33000000"
           CornerRadius="12"
           KeyboardNavigation.TabNavigation="Cycle"
           AutomationProperties.ControlTypeOverride="Window"
           AutomationProperties.Name="시간표 편집 대화상자">
        <Grid>
          <StackPanel
              IsVisible="{Binding IsRenamingPlan}"
              Spacing="14"
              AutomationProperties.Name="시간표 이름 변경">
            <TextBlock
                AutomationProperties.HeadingLevel="1"
                FontSize="21"
                FontWeight="SemiBold"
                Text="시간표 이름 변경" />
            <TextBox
                x:Name="PlanNameEditor"
                MaxLength="80"
                Text="{Binding PlanNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="시간표 이름"
                AutomationProperties.HelpText="{Binding PlanNameValidationMessage}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmRenamePlanCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding CancelRenamePlanCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock
                x:Name="PlanNameValidationMessage"
                FontSize="12"
                Foreground="{DynamicResource ErrorBrush}"
                IsVisible="{Binding HasPlanNameValidationMessage}"
                Text="{Binding PlanNameValidationMessage}"
                AutomationProperties.LiveSetting="Assertive" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  Classes="outline"
                  Command="{Binding CancelRenamePlanCommand}"
                  Content="취소" />
              <Button
                  Classes="accent"
                  Command="{Binding ConfirmRenamePlanCommand}"
                  Content="저장" />
            </StackPanel>
          </StackPanel>

          <StackPanel
              IsVisible="{Binding IsDeletePlanConfirmationVisible}"
              Spacing="14"
              AutomationProperties.Name="계획 닫기 확인">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                Background="{DynamicResource ErrorSubtleBrush}"
                CornerRadius="22">
              <icons:FluentIcon
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="Delete"
                  IconVariant="Regular"
                  Foreground="{DynamicResource ErrorBrush}" />
            </Border>
            <TextBlock
                AutomationProperties.HeadingLevel="1"
                FontSize="21"
                FontWeight="SemiBold"
                Text="계획을 닫을까요?" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="{Binding PlanDeletionDescription}"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  x:Name="CancelDeletePlanButton"
                  Classes="outline"
                  Command="{Binding CancelDeletePlanCommand}"
                  Content="취소" />
              <Button
                  Classes="danger"
                  Command="{Binding ConfirmDeletePlanCommand}"
                  Content="계획 닫기" />
            </StackPanel>
          </StackPanel>

          <StackPanel
              IsVisible="{Binding IsClearActivePlanConfirmationVisible}"
              Spacing="14"
              AutomationProperties.Name="계획 비우기 확인">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                Background="{DynamicResource ErrorSubtleBrush}"
                CornerRadius="22">
              <icons:FluentIcon
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="Delete"
                  IconVariant="Regular"
                  Foreground="{DynamicResource ErrorBrush}" />
            </Border>
            <TextBlock
                AutomationProperties.HeadingLevel="1"
                FontSize="21"
                FontWeight="SemiBold"
                Text="계획을 비울까요?" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="{Binding PlanClearDescription}"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  x:Name="CancelClearActivePlanButton"
                  Classes="outline"
                  Command="{Binding CancelClearActivePlanCommand}"
                  Content="취소" />
              <Button
                  Classes="danger"
                  Command="{Binding ConfirmClearActivePlanCommand}"
                  Content="모두 지우기" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border
        x:Name="CourseChoiceEditorOverlay"
        ZIndex="13"
        IsVisible="{Binding IsCourseChoiceEditorVisible}"
        Background="{DynamicResource OverlayScrimBrush}"
        AutomationProperties.LiveSetting="Assertive">
      <Border
          x:Name="CourseChoiceEditorDialog"
          MaxWidth="820"
          MaxHeight="860"
          Margin="16"
          Padding="28"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          BoxShadow="0 18 48 0 #33000000"
          CornerRadius="12"
          KeyboardNavigation.TabNavigation="Cycle"
          AutomationProperties.ControlTypeOverride="Window"
          AutomationProperties.Name="수강 선택 대화상자">
        <views:CourseChoiceEditorView x:Name="CourseChoiceEditor" />
      </Border>
    </Border>

    <Border
        x:Name="PersonalScheduleEditorOverlay"
        ZIndex="14"
        IsVisible="{Binding IsPersonalScheduleOverlayVisible}"
        Background="{DynamicResource OverlayScrimBrush}"
        AutomationProperties.LiveSetting="Assertive">
      <Border
          x:Name="PersonalScheduleEditorDialog"
          MaxWidth="680"
          MaxHeight="760"
          Margin="16"
          Padding="28"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
           BorderThickness="1"
           BoxShadow="0 18 48 0 #33000000"
           CornerRadius="12"
           KeyboardNavigation.TabNavigation="Cycle"
           AutomationProperties.ControlTypeOverride="Window"
           AutomationProperties.Name="개인 일정 대화상자">
        <Grid>
          <views:PersonalScheduleEditorView
              x:Name="PersonalScheduleEditor"
              IsVisible="{Binding IsPersonalScheduleEditorVisible}" />

          <StackPanel
              IsVisible="{Binding IsDeletePersonalScheduleConfirmationVisible}"
              Spacing="14"
              AutomationProperties.Name="개인 일정 삭제 확인">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                Background="{DynamicResource ErrorSubtleBrush}"
                CornerRadius="22">
              <icons:FluentIcon
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="Delete"
                  IconVariant="Regular"
                  Foreground="{DynamicResource ErrorBrush}" />
            </Border>
            <TextBlock
                x:Name="DeletePersonalScheduleHeading"
                AutomationProperties.HeadingLevel="1"
                FontSize="21"
                FontWeight="SemiBold"
                Text="개인 일정을 삭제할까요?" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="{Binding PersonalScheduleDeletionDescription}"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  x:Name="CancelDeletePersonalScheduleButton"
                  Classes="outline"
                  Command="{Binding CancelDeletePersonalScheduleCommand}"
                  Content="취소" />
              <Button
                  Classes="danger"
                  Command="{Binding ConfirmDeletePersonalScheduleCommand}"
                  Content="일정 삭제" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
