<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ProductWorkspaceHostView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel">
  <Grid>
    <Grid
        x:Name="WorkspaceSurface"
        RowDefinitions="56,44,*"
        IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
    <Border
        x:Name="ProductTitleBar"
        Grid.Row="0"
        Padding="{DynamicResource WindowTitleBarContentPadding}"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Banner"
        WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
        <Grid Grid.Column="0" ColumnDefinitions="30,Auto" ColumnSpacing="14">
          <Border
              Grid.Column="0"
              Width="30"
              Height="30"
              ClipToBounds="True">
            <Image
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/AppIcon.png"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False" />
          </Border>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="20"
              FontWeight="SemiBold"
              Text="시간표" />
        </Grid>

        <Border
            Grid.Column="1"
            Width="1"
            Height="24"
            Margin="24,0"
            Background="{DynamicResource BorderBrush}" />

        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="15"
            FontWeight="SemiBold"
            Text="{Binding InstitutionTermDisplayText}" />

        <Grid
            Grid.Column="3"
            Margin="28,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="자동 저장 상태"
            AutomationProperties.LiveSetting="Polite">
          <StackPanel
              Orientation="Horizontal"
              Spacing="8"
              IsVisible="{Binding IsAutosaveSaved}">
            <icons:FluentIcon
                Width="18"
                Height="18"
                Icon="CheckmarkCircle"
                IconVariant="Regular"
                Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding AutosaveStatusText}" />
          </StackPanel>
          <StackPanel
              Orientation="Horizontal"
              Spacing="8"
              IsVisible="{Binding IsAutosaveSaving}">
            <ProgressBar Width="34" Height="3" IsIndeterminate="True" />
            <TextBlock
                VerticalAlignment="Center"
                Classes="secondary"
                Text="{Binding AutosaveStatusText}" />
          </StackPanel>
          <Button
              Padding="4,2"
              MinHeight="30"
              HorizontalAlignment="Left"
              Background="Transparent"
              BorderBrush="Transparent"
              Foreground="{DynamicResource ErrorBrush}"
              IsVisible="{Binding HasAutosaveError}"
              Command="{Binding RetryAutosaveCommand}"
              ToolTip.Tip="다시 저장">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:FluentIcon Icon="ErrorCircle" IconVariant="Regular" FontSize="18" />
              <TextBlock VerticalAlignment="Center" Text="저장 실패 · 다시 시도" />
            </StackPanel>
          </Button>
        </Grid>

        <Button
            x:Name="HelpButton"
            Grid.Column="4"
            Classes="icon"
            Margin="0,0,10,0"
            Click="onHelpClicked"
            AutomationProperties.Name="도움말"
            ToolTip.Tip="도움말 (F1)"
            WindowDecorationProperties.ElementRole="User">
          <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" FontSize="21" />
        </Button>

      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1"
        AutomationProperties.LandmarkType="Navigation">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <ScrollViewer
            x:Name="PlanTabScrollViewer"
            Grid.Column="0"
            MaxWidth="720"
            HorizontalAlignment="Left"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
          <TabStrip
              Classes="plan-tabs"
              ItemsSource="{Binding Plans}"
              SelectedItem="{Binding ActivePlan, Mode=TwoWay}"
              AutomationProperties.Name="계획 목록">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="models:PlanTabItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                      MaxWidth="160"
                      VerticalAlignment="Center"
                      Text="{Binding DisplayName}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding DisplayName}" />
                  <Button
                      Classes="subtle icon"
                      Width="26"
                      Height="26"
                      MinWidth="26"
                      MinHeight="26"
                      Padding="0"
                      IsEnabled="{Binding CanClose}"
                      Command="{Binding CloseCommand}"
                      AutomationProperties.Name="{Binding CloseButtonAccessibleName}"
                      AutomationProperties.HelpText="{Binding CloseButtonHelpText}"
                      ToolTip.Tip="{Binding CloseButtonHelpText}">
                    <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
        </ScrollViewer>

        <Button
            x:Name="AddPlanButton"
            Grid.Column="1"
            Classes="icon"
            Margin="8,4"
            Command="{Binding AddPlanCommand}"
            AutomationProperties.Name="새 계획 추가"
            ToolTip.Tip="새 계획 추가">
          <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="20" />
        </Button>
      </Grid>
    </Border>

    <SplitView
        Grid.Row="2"
        PanePlacement="Left"
        DisplayMode="{Binding CoursePaneDisplayMode}"
        IsPaneOpen="{Binding IsCoursePaneOpen, Mode=TwoWay}"
        OpenPaneLength="{Binding CoursePaneWidth}"
        PaneBackground="{DynamicResource SurfaceBrush}"
        UseLightDismissOverlayMode="True">
      <SplitView.Pane>
        <views:CourseBrowserView />
      </SplitView.Pane>

      <SplitView.Content>
        <SplitView
            PanePlacement="Right"
            DisplayMode="{Binding InspectorPaneDisplayMode}"
            IsPaneOpen="{Binding IsInspectorPaneOpen, Mode=TwoWay}"
            OpenPaneLength="{Binding InspectorPaneWidth}"
            PaneBackground="{DynamicResource SurfaceBrush}"
            UseLightDismissOverlayMode="True">
          <SplitView.Pane>
            <views:PlanInspectorView />
          </SplitView.Pane>

          <SplitView.Content>
            <views:ScheduleWorkspaceView />
          </SplitView.Content>
        </SplitView>
      </SplitView.Content>
    </SplitView>
    </Grid>

    <Border
        x:Name="PlanEditingOverlay"
        ZIndex="12"
        IsVisible="{Binding IsPlanEditingOverlayVisible}"
        Background="{DynamicResource OverlayScrimBrush}"
        AutomationProperties.LiveSetting="Assertive">
      <Border
          x:Name="PlanEditingDialog"
          Width="420"
          MaxWidth="420"
          Margin="24"
          Padding="28"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          BoxShadow="0 18 48 0 #33000000"
          CornerRadius="12">
        <Grid>
          <StackPanel
              IsVisible="{Binding IsRenamingPlan}"
              Spacing="14"
              AutomationProperties.Name="계획 이름 바꾸기">
            <TextBlock
                FontSize="21"
                FontWeight="SemiBold"
                Text="계획 이름 바꾸기" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="구분하기 쉬운 이름을 입력하세요. 이름은 언제든 다시 바꿀 수 있습니다."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="PlanNameEditor"
                MaxLength="80"
                Text="{Binding PlanNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="계획 이름">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmRenamePlanCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding CancelRenamePlanCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource ErrorBrush}"
                IsVisible="{Binding HasPlanNameValidationMessage}"
                Text="{Binding PlanNameValidationMessage}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  Classes="outline"
                  Command="{Binding CancelRenamePlanCommand}"
                  Content="취소" />
              <Button
                  Classes="accent"
                  Command="{Binding ConfirmRenamePlanCommand}"
                  Content="저장" />
            </StackPanel>
          </StackPanel>

          <StackPanel
              IsVisible="{Binding IsDeletePlanConfirmationVisible}"
              Spacing="14"
              AutomationProperties.Name="계획 닫기 확인">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                Background="{DynamicResource ErrorSubtleBrush}"
                CornerRadius="22">
              <icons:FluentIcon
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Icon="Delete"
                  IconVariant="Regular"
                  Foreground="{DynamicResource ErrorBrush}" />
            </Border>
            <TextBlock
                FontSize="21"
                FontWeight="SemiBold"
                Text="계획을 닫을까요?" />
            <TextBlock
                Classes="secondary"
                LineHeight="21"
                Text="{Binding PlanDeletionDescription}"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button
                  x:Name="CancelDeletePlanButton"
                  Classes="outline"
                  Command="{Binding CancelDeletePlanCommand}"
                  Content="취소" />
              <Button
                  Classes="danger"
                  Command="{Binding ConfirmDeletePlanCommand}"
                  Content="계획 닫기" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
