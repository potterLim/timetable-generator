<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ScheduleBoardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    x:DataType="models:ScheduleBoardPresentation"
    VerticalAlignment="Top"
    AutomationProperties.Name="주간 시간표">
  <UserControl.Resources>
    <ControlTheme x:Key="ProductScheduleCardButtonTheme" TargetType="Button">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              x:Name="PART_ScheduleCardSurface"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              ClipToBounds="True"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Border
                  x:Name="PART_InteractionOverlay"
                  Background="{DynamicResource TextPrimaryBrush}"
                  IsHitTestVisible="False"
                  Opacity="0" />
              <ContentPresenter
                  x:Name="PART_ContentPresenter"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  Foreground="{TemplateBinding Foreground}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  Padding="{TemplateBinding Padding}"
                  RecognizesAccessKey="True"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_InteractionOverlay">
        <Setter Property="Opacity" Value="0.04" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_InteractionOverlay">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_ScheduleCardSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource ProductFocusStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.schedule-card">
      <Setter Property="Theme" Value="{StaticResource ProductScheduleCardButtonTheme}" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.schedule-card.blue">
      <Setter Property="Background" Value="{DynamicResource CourseBlueBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.purple">
      <Setter Property="Background" Value="{DynamicResource CoursePurpleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.green">
      <Setter Property="Background" Value="{DynamicResource CourseGreenBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.personal">
      <Setter Property="Background" Value="{DynamicResource PersonalScheduleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PersonalScheduleBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.schedule-card.personal.compact">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ScrollViewer#ScheduleScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Margin" Value="0,6,4,6" />
    </Style>
  </UserControl.Styles>

  <Border
      x:Name="BoardFrame"
      CornerRadius="7"
      BorderBrush="{DynamicResource StrongBorderBrush}"
      BorderThickness="1"
      ClipToBounds="True"
      Background="{DynamicResource ElevatedSurfaceBrush}"
      UseLayoutRounding="True">
    <Grid RowDefinitions="Auto,*">
      <Border
          x:Name="BoardStickyHeaderContainer"
          Grid.Row="0"
          Height="42"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0">
        <Border
            x:Name="BoardStickyDayHeaderSurface"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
          <Grid x:Name="BoardStickyDayHeaderGrid" />
        </Border>
      </Border>

      <ScrollViewer
          x:Name="ScheduleScrollViewer"
          Grid.Row="1"
          AllowAutoHide="True"
          HorizontalContentAlignment="Stretch"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          AutomationProperties.Name="시간표 시간 스크롤">
        <Border
            x:Name="PngExportCanvas"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            UseLayoutRounding="True">
          <Border
              x:Name="BoardExportSurface"
              BorderBrush="{DynamicResource StrongBorderBrush}"
              BorderThickness="0"
              Background="{DynamicResource ElevatedSurfaceBrush}">
            <StackPanel Background="{DynamicResource ElevatedSurfaceBrush}">
              <Border
                  x:Name="BoardContextHeader"
                  Padding="18,15"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Background="{DynamicResource ElevatedSurfaceBrush}">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="{Binding PlanName.Value}"
                    TextTrimming="CharacterEllipsis" />
              </Border>
              <Grid
                  x:Name="BoardGrid"
                  Background="{DynamicResource ElevatedSurfaceBrush}" />
            </StackPanel>
          </Border>
        </Border>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
