<UserControl
    x:Class="TimetableGenerator.Desktop.Views.ScheduleBoardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    x:DataType="models:ScheduleBoardPresentation"
    MinHeight="260"
    AutomationProperties.Name="주간 시간표">
  <UserControl.Resources>
    <ControlTheme x:Key="ProductScheduleCardButtonTheme" TargetType="Button">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter
              x:Name="PART_ContentPresenter"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Foreground="{TemplateBinding Foreground}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              Padding="{TemplateBinding Padding}"
              RecognizesAccessKey="True"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.schedule-card">
      <Setter Property="Theme" Value="{StaticResource ProductScheduleCardButtonTheme}" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.schedule-card.blue">
      <Setter Property="Background" Value="{DynamicResource CourseBlueBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.purple">
      <Setter Property="Background" Value="{DynamicResource CoursePurpleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.green">
      <Setter Property="Background" Value="{DynamicResource CourseGreenBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.schedule-card.personal">
      <Setter Property="Background" Value="{DynamicResource PersonalScheduleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PersonalScheduleBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.schedule-card.personal.compact">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Styles>

  <Border
      CornerRadius="7"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1"
      ClipToBounds="True"
      Background="{DynamicResource ElevatedSurfaceBrush}">
    <ScrollViewer
        x:Name="ScheduleScrollViewer"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        AutomationProperties.Name="시간표 시간 스크롤">
      <Grid x:Name="BoardViewportLayout" ColumnDefinitions="*,16">
        <Border
            x:Name="BoardExportSurface"
            Grid.Column="0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Background="{DynamicResource ElevatedSurfaceBrush}">
          <StackPanel Background="{DynamicResource ElevatedSurfaceBrush}">
            <Border
                x:Name="BoardContextHeader"
                Padding="18,15"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource ElevatedSurfaceBrush}">
              <StackPanel Spacing="3">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="{Binding PlanName.Value}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Classes="caption"
                    Text="{Binding InstitutionTermDisplayText}" />
              </StackPanel>
            </Border>
            <Grid
                x:Name="BoardGrid"
                Background="{DynamicResource ElevatedSurfaceBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Border>
</UserControl>
