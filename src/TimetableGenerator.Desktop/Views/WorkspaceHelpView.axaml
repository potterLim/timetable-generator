<UserControl
    x:Class="TimetableGenerator.Desktop.Views.WorkspaceHelpView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    Width="272">
  <StackPanel Margin="6" Spacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          FontSize="16"
          FontWeight="SemiBold"
          Text="시간표 만들기" />
      <Button
          x:Name="DismissHelpButton"
          Grid.Column="1"
          Classes="subtle icon"
          Width="30"
          Height="30"
          MinWidth="30"
          MinHeight="30"
          Padding="0"
          Click="onDismissClicked"
          AutomationProperties.Name="도움말 닫기">
        <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="15" />
      </Button>
    </Grid>
    <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="1" />
      <TextBlock Grid.Column="1" Classes="secondary" Text="왼쪽에서 과목을 추가하세요." TextWrapping="Wrap" />
    </Grid>
    <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="2" />
      <TextBlock Grid.Column="1" Classes="secondary" Text="가운데에서 추천 조합을 비교하세요." TextWrapping="Wrap" />
    </Grid>
    <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="3" />
      <TextBlock Grid.Column="1" Classes="secondary" Text="시간 미정 과목은 내 계획에서 확인하세요." TextWrapping="Wrap" />
    </Grid>
    <TextBlock
        Margin="28,2,0,0"
        Classes="caption"
        Text="F1을 누르면 다시 볼 수 있습니다."
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
