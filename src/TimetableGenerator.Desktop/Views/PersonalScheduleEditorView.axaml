<UserControl
    x:Class="TimetableGenerator.Desktop.Views.PersonalScheduleEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    xmlns:views="using:TimetableGenerator.Desktop.Views"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    KeyboardNavigation.TabNavigation="Cycle"
    AutomationProperties.Name="개인 일정 편집기">
  <UserControl.Styles>
    <Style Selector="ToggleButton.day-option">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.day-option:checked">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,18,*,12,Auto,16,Auto">
    <StackPanel Grid.Row="0" Spacing="7">
      <TextBlock
          FontSize="22"
          FontWeight="SemiBold"
          Text="{Binding PersonalScheduleEditorHeading}" />
      <TextBlock
          Classes="secondary"
          LineHeight="20"
          Text="{Binding PersonalScheduleEditorDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer
        Grid.Row="2"
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel Spacing="7">
          <TextBlock FontWeight="SemiBold" Text="일정 이름 (필수)" />
          <TextBox
              x:Name="PersonalScheduleNameInput"
              MaxLength="80"
              PlaceholderText="예: 랩 미팅, 점심 약속"
              Text="{Binding PersonalScheduleTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AutomationProperties.AutomationId="PersonalScheduleNameInput"
              AutomationProperties.Name="개인 일정 이름" />
        </StackPanel>

        <StackPanel Spacing="8">
          <StackPanel Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="요일 (필수)" />
            <TextBlock Classes="caption" Text="반복할 요일을 여러 개 선택할 수 있습니다." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding PersonalScheduleDayOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PersonalScheduleDayOption">
                <ToggleButton
                    Classes="day-option"
                    Margin="3,0"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Content="{Binding ShortName}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AccessibleName}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0" Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="시작 (필수)" />
            <views:ProductTimePicker
                x:Name="PersonalScheduleStartTimeInput"
                AccessibleContextName="시작 시간"
                SelectedTimeOrNull="{Binding PersonalScheduleStartTimeOrNull, Mode=TwoWay}"
                AutomationProperties.AutomationId="PersonalScheduleStartTimeInput"
                AutomationProperties.Name="개인 일정 시작 시간" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="종료 (필수)" />
            <views:ProductTimePicker
                x:Name="PersonalScheduleEndTimeInput"
                AccessibleContextName="종료 시간"
                SelectedTimeOrNull="{Binding PersonalScheduleEndTimeOrNull, Mode=TwoWay}"
                AutomationProperties.AutomationId="PersonalScheduleEndTimeInput"
                AutomationProperties.Name="개인 일정 종료 시간" />
          </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderBrush}" />

        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="세부 정보" />
          <TextBlock Classes="caption" Text="필요한 항목만 입력하세요." />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0" Spacing="7">
            <TextBlock Text="분반 (선택)" />
            <TextBox
                x:Name="PersonalScheduleSectionInput"
                MaxLength="40"
                PlaceholderText="예: A"
                Text="{Binding PersonalScheduleSectionDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="PersonalScheduleSectionInput"
                AutomationProperties.Name="개인 일정 분반" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="7">
            <TextBlock Text="담당교원 (선택)" />
            <TextBox
                x:Name="PersonalScheduleInstructorInput"
                MaxLength="80"
                PlaceholderText="예: 김교수"
                Text="{Binding PersonalScheduleInstructorDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="PersonalScheduleInstructorInput"
                AutomationProperties.Name="개인 일정 담당교원" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="7">
          <TextBlock Text="장소 (선택)" />
          <TextBox
              x:Name="PersonalScheduleLocationInput"
              MaxLength="120"
              PlaceholderText="예: 느헤미야홀 101호"
              Text="{Binding PersonalScheduleLocationDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AutomationProperties.AutomationId="PersonalScheduleLocationInput"
              AutomationProperties.Name="개인 일정 장소" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Border
        x:Name="PersonalScheduleValidationSummary"
        Grid.Row="4"
        Padding="12,10"
        IsVisible="{Binding HasPersonalScheduleValidationMessage}"
        Background="{DynamicResource ErrorSubtleBrush}"
        CornerRadius="7"
        AutomationProperties.LiveSetting="Assertive">
      <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
        <icons:FluentIcon
            Icon="ErrorCircle"
            IconVariant="Regular"
            FontSize="17"
            Foreground="{DynamicResource ErrorBrush}" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource ErrorBrush}"
            Text="{Binding PersonalScheduleValidationMessage}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <StackPanel
        Grid.Row="6"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="CancelPersonalScheduleEditButton"
          Classes="outline"
          MinWidth="88"
          Command="{Binding CancelPersonalScheduleEditCommand}"
          Content="취소"
          AutomationProperties.Name="개인 일정 편집 취소" />
      <Button
          x:Name="SavePersonalScheduleButton"
          Classes="accent"
          MinWidth="104"
          Command="{Binding SavePersonalScheduleCommand}"
          Content="{Binding PersonalScheduleSaveButtonText}"
          AutomationProperties.Name="개인 일정 저장" />
    </StackPanel>
  </Grid>
</UserControl>
