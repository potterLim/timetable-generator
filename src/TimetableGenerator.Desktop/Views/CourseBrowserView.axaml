<UserControl
    x:Class="TimetableGenerator.Desktop.Views.CourseBrowserView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    x:CompileBindings="False"
    AutomationProperties.LandmarkType="Search"
    AutomationProperties.Name="과목 찾기">
  <UserControl.Styles>
    <Style Selector="Border.course-item.blue">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
    </Style>
    <Style Selector="Border.course-item.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
    </Style>
    <Style Selector="Border.course-item.green">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="0,0,1,0">
    <Grid Margin="18,20,16,14" RowDefinitions="Auto,14,40,12,40,14,1,16,Auto,8,*">
      <TextBlock
          Grid.Row="0"
          Classes="title"
          AutomationProperties.HeadingLevel="2"
          Text="과목 찾기" />

      <Grid Grid.Row="2">
        <TextBox
            x:Name="CourseSearchBox"
            Padding="36,8,10,8"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="과목명, 코드, 교수 검색"
            AutomationProperties.AutomationId="CourseSearchBox"
            AutomationProperties.Name="과목 검색어" />
        <icons:FluentIcon
            Width="18"
            Height="18"
            Margin="11,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Icon="Search"
            IconVariant="Regular"
            Foreground="{DynamicResource TextTertiaryBrush}"
            IsHitTestVisible="False" />
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="*,12,*">
        <ComboBox
            Grid.Column="0"
            ItemsSource="{Binding UnitFilters}"
            SelectedItem="{Binding SelectedUnitFilter, Mode=TwoWay}"
            AutomationProperties.AutomationId="DepartmentFilter"
            AutomationProperties.Name="학부 필터">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox
            Grid.Column="2"
            ItemsSource="{Binding RequirementFilters}"
            SelectedItem="{Binding SelectedRequirementFilter, Mode=TwoWay}"
            AutomationProperties.AutomationId="RequirementFilter"
            AutomationProperties.Name="이수 구분 필터">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Border Grid.Row="6" Background="{DynamicResource BorderBrush}" />

      <TextBlock
          Grid.Row="8"
          Classes="secondary"
          FontSize="13"
          Text="{Binding VisibleCourseHeading}" />

      <ListBox
          x:Name="CourseResultsList"
          Grid.Row="10"
          Classes="workspace-list"
          ItemsSource="{Binding VisibleCourses}"
          AutomationProperties.AutomationId="CourseResults"
          AutomationProperties.Name="과목 검색 결과">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:CourseSearchItem">
            <Border
                Classes="course-item"
                Classes.blue="{Binding IsBlue}"
                Classes.purple="{Binding IsPurple}"
                Classes.green="{Binding IsGreen}"
                MinHeight="96"
                BorderThickness="3,0,0,1"
                Background="{DynamicResource SurfaceBrush}">
              <Grid Margin="13,10,10,9" ColumnDefinitions="*,38" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="caption"
                    Text="{Binding Code}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,2,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Classes="caption"
                    Text="{Binding InstructorCreditDisplayText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,3,0,0"
                    Classes="caption"
                    Text="{Binding MeetingLocationDisplayText}"
                    TextWrapping="Wrap" />

                <ComboBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,2"
                    MinHeight="34"
                    ItemsSource="{Binding SelectionOptions}"
                    SelectedItem="{Binding SelectedSelectionOption, Mode=TwoWay}"
                    IsEnabled="{Binding IsSelectionEnabled}"
                    IsVisible="{Binding HasMultipleSelectionOptions}"
                    AutomationProperties.Name="추가할 분반 선택">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:CourseSelectionOption">
                      <TextBlock
                          MaxWidth="260"
                          Text="{Binding DisplayName}"
                          TextTrimming="CharacterEllipsis"
                          ToolTip.Tip="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <Button
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    Classes="icon course-add"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !IsAdded}"
                    Command="{Binding DataContext.AddCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AddButtonAccessibleName}"
                    ToolTip.Tip="계획에 추가">
                  <icons:FluentIcon
                      Icon="AddCircle"
                      IconVariant="Regular"
                      FontSize="22"
                      Foreground="{DynamicResource AccentBrush}" />
                </Button>

                <Border
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsAdded}"
                    AutomationProperties.Name="{Binding AddButtonAccessibleName}">
                  <icons:FluentIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Icon="CheckmarkCircle"
                      IconVariant="Filled"
                      FontSize="22"
                      Foreground="{DynamicResource SuccessBrush}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
