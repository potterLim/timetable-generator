<UserControl
    x:Class="TimetableGenerator.Desktop.Views.CourseBrowserView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:TimetableGenerator.Desktop.Views"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    AutomationProperties.LandmarkType="Search"
    AutomationProperties.Name="과목 찾기">
  <UserControl.Styles>
    <Style Selector="Border.course-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.course-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="Border.course-item.added">
      <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.course-item.added:pointerover">
      <Setter Property="Background" Value="{DynamicResource SelectionHoverSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.course-item.added:pressed">
      <Setter Property="Background" Value="{DynamicResource SelectionPressedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource PaneSurfaceBrush}"
      BorderBrush="{DynamicResource PaneDividerBrush}"
      BorderThickness="0,0,1,0">
    <Grid Margin="18,20,16,14" RowDefinitions="Auto,14,40,12,88,14,1,16,Auto,8,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock
            Classes="title"
            VerticalAlignment="Center"
            AutomationProperties.HeadingLevel="2"
            Text="과목 찾기" />
        <Button
            x:Name="CloseCoursePaneButton"
            Grid.Column="1"
            Classes="icon"
            Width="36"
            Height="36"
            MinWidth="36"
            MinHeight="36"
            IsVisible="{Binding IsCoursePaneDismissActionVisible}"
            Command="{Binding ToggleCoursePaneCommand}"
            AutomationProperties.Name="과목 찾기 패널 닫기"
            ToolTip.Tip="과목 찾기 닫기">
          <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
        </Button>
      </Grid>

      <Grid Grid.Row="2">
        <local:CompositionAwareSearchTextBox
            x:Name="CourseSearchBox"
            Padding="36,0,12,0"
            QueryText="{Binding SearchText, Mode=TwoWay}"
            PlaceholderText="과목명, 코드, 교수 검색"
            AutomationProperties.AutomationId="CourseSearchBox"
            AutomationProperties.Name="과목 검색어" />
        <icons:FluentIcon
            Width="18"
            Height="18"
            Margin="11,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Icon="Search"
            IconVariant="Regular"
            Foreground="{DynamicResource TextTertiaryBrush}"
            IsHitTestVisible="False" />
      </Grid>

      <Grid Grid.Row="4" RowDefinitions="40,8,40">
        <ComboBox
            x:Name="DepartmentFilter"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding UnitFilters}"
            SelectedItem="{Binding SelectedUnitFilter, Mode=TwoWay}"
            AutomationProperties.AutomationId="DepartmentFilter"
            AutomationProperties.Name="학부 필터">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:CourseUnitFilterOption">
              <TextBlock
                  Height="18"
                  LineHeight="18"
                  VerticalAlignment="Center"
                  Text="{Binding DisplayName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip.Tip="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox
            x:Name="RequirementFilter"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding RequirementFilters}"
            SelectedItem="{Binding SelectedRequirementFilter, Mode=TwoWay}"
            AutomationProperties.AutomationId="RequirementFilter"
            AutomationProperties.Name="이수 구분 필터">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:RequirementFilterOption">
              <TextBlock
                  Height="18"
                  LineHeight="18"
                  VerticalAlignment="Center"
                  Text="{Binding DisplayName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip.Tip="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Border Grid.Row="6" Background="{DynamicResource BorderBrush}" />

      <TextBlock
          Grid.Row="8"
          Classes="secondary"
          FontSize="13"
          AutomationProperties.LiveSetting="Polite"
          Text="{Binding VisibleCourseHeading}" />

      <Grid Grid.Row="10">
        <ListBox
            x:Name="CourseResultsList"
            Classes="workspace-list"
            ItemsSource="{Binding VisibleCourses}"
            IsVisible="{Binding HasVisibleCourses}"
            AutomationProperties.AutomationId="CourseResults"
            AutomationProperties.Name="과목 검색 결과">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:CourseSearchItem">
              <Border
                  Classes="course-item"
                  Classes.added="{Binding IsAdded}"
                  MinHeight="80"
                  Margin="0,0,2,4"
                  AutomationProperties.Name="{Binding CourseBrowserAccessibleName}">
                <Grid Margin="13,10,10,9" ColumnDefinitions="*,38" RowDefinitions="Auto,Auto,Auto,Auto">
                  <TextBlock
                      Grid.Row="0"
                      Grid.Column="0"
                      Classes="caption"
                      Text="{Binding Code}" />
                  <TextBlock
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,2,0,0"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding Name}" />
                  <TextBlock
                      Grid.Row="2"
                      Grid.Column="0"
                      Margin="0,5,0,0"
                      Classes="caption"
                      Text="{Binding CourseBrowserMetadataDisplayText}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Grid.Row="3"
                      Grid.Column="0"
                      Margin="0,3,0,0"
                      Classes="caption"
                      IsVisible="{Binding HasSingleOfferingDetails}"
                      Text="{Binding SingleOfferingDetailsDisplayText}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding SingleOfferingDetailsDisplayText}" />

                  <Button
                      Grid.Row="0"
                      Grid.RowSpan="4"
                      Grid.Column="1"
                      Classes="icon course-add"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsDirectAddButtonVisible}"
                      Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).AddCourseCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding AddButtonAccessibleName}"
                      AutomationProperties.HelpText="{Binding AddButtonHelpText}"
                      ToolTip.Tip="{Binding AddButtonToolTipText}">
                    <icons:FluentIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="AddCircle"
                        IconVariant="Regular"
                        FontSize="22"
                        Foreground="{DynamicResource AccentBrush}" />
                  </Button>

                  <Button
                      Grid.Row="0"
                      Grid.RowSpan="4"
                      Grid.Column="1"
                      Classes="icon"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsAdded}"
                      Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).EditOrRemoveSelectedCourseCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding SelectedCourseActionAccessibleName}"
                      AutomationProperties.HelpText="{Binding EnglishInstructionAccessibleText}"
                      ToolTip.Tip="{Binding SelectedCourseActionToolTipText}">
                    <icons:FluentIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="CheckmarkCircle"
                        IconVariant="Filled"
                        FontSize="22"
                        Foreground="{DynamicResource SuccessBrush}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            x:Name="NoCourseResultsState"
            Width="230"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            IsVisible="{Binding HasNoVisibleCourses}"
            AutomationProperties.Name="검색 결과 없음">
          <Border
              Width="42"
              Height="42"
              Margin="0,0,0,4"
              HorizontalAlignment="Center"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="21">
            <icons:FluentIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Icon="Search"
                IconVariant="Regular"
                FontSize="20"
                Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="15"
              FontWeight="SemiBold"
              Text="일치하는 과목이 없습니다" />
          <TextBlock
              HorizontalAlignment="Center"
              Classes="secondary"
              Text="검색어 또는 필터를 바꿔 다시 찾아보세요."
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              x:Name="ResetCourseSearchButton"
              Classes="outline"
              MinHeight="40"
              Margin="0,6,0,0"
              HorizontalAlignment="Center"
              VerticalContentAlignment="Center"
              Command="{Binding ResetCourseSearchCommand}"
              Content="검색 및 필터 초기화"
              AutomationProperties.Name="검색 및 필터 초기화" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
