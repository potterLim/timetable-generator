<UserControl
    x:Class="TimetableGenerator.Desktop.Views.CourseChoiceEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    AutomationProperties.AutomationId="CourseChoiceEditor"
    AutomationProperties.Name="수강 선택 편집기">
  <UserControl.Styles>
    <Style Selector="ToggleButton.preference-choice">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.preference-choice:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.preference-choice:checked">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.preference-choice:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource ProductFocusStrokeBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.preference-choice.excluded:checked">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.preference-choice.excluded:checked:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource ProductFocusStrokeBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,16,*,16,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="{Binding CourseChoiceEditorTitle}"
            AutomationProperties.HeadingLevel="1" />
        <TextBlock
            MaxWidth="680"
            Classes="secondary"
            LineHeight="21"
            Text="{Binding CourseChoiceEditorDescription}"
            TextWrapping="Wrap" />
      </StackPanel>
      <Button
          x:Name="CloseCourseChoiceEditorButton"
          Grid.Column="1"
          Classes="icon"
          Width="36"
          Height="36"
          MinWidth="36"
          MinHeight="36"
          Command="{Binding CancelCourseChoiceEditCommand}"
          AutomationProperties.Name="수강 선택 편집기 닫기"
          ToolTip.Tip="닫기">
        <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="18" />
      </Button>
    </Grid>

    <ScrollViewer
        Grid.Row="2"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0" Spacing="14">
        <Border
            Padding="12,10"
            Background="{DynamicResource AccentTintBrush}"
            CornerRadius="8">
          <TextBlock
              Classes="caption"
              LineHeight="18"
              Text="선호 분반을 먼저 추천하고, 충돌하면 가능 분반을 사용합니다. 제외한 분반은 추천하지 않습니다."
              TextWrapping="Wrap" />
        </Border>
        <ItemsControl ItemsSource="{Binding CourseChoiceDraftCourses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CourseChoiceDraftCourseItem">
              <Border
                  Margin="0,0,0,12"
                  Padding="16"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding Code}" />
                        <TextBlock Classes="caption" Text="{Binding CreditDisplayText}" />
                      </StackPanel>
                      <TextBlock
                          Margin="0,3,0,0"
                          FontSize="17"
                          FontWeight="SemiBold"
                          Text="{Binding Name}"
                          TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="icon"
                        Width="34"
                        Height="34"
                        MinWidth="34"
                        MinHeight="34"
                        IsVisible="{Binding CanRemove}"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveCourseChoiceDraftCourseCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="대안 과목에서 제거">
                      <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" />
                    </Button>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Offerings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CourseOfferingPreferenceItem">
                        <Border
                            Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            AutomationProperties.Name="{Binding PreferenceAccessibleName}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SectionDisplayText}" />
                                <TextBlock Classes="caption" Text="{Binding ScheduleDisplayText}" />
                              </StackPanel>
                              <TextBlock
                                  Classes="caption"
                                  Text="{Binding LogisticsDisplayText}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{Binding LogisticsDisplayText}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                              <ToggleButton
                                  Classes="preference-choice"
                                  IsChecked="{Binding IsPreferred, Mode=OneWay}"
                                  Command="{Binding SelectPreferredCommand}"
                                  Content="선호"
                                  AutomationProperties.Name="{Binding PreferredButtonAccessibleName}" />
                              <ToggleButton
                                  Classes="preference-choice"
                                  IsChecked="{Binding IsAcceptable, Mode=OneWay}"
                                  Command="{Binding SelectAcceptableCommand}"
                                  Content="가능"
                                  AutomationProperties.Name="{Binding AcceptableButtonAccessibleName}" />
                              <ToggleButton
                                  Classes="preference-choice excluded"
                                  IsChecked="{Binding IsExcluded, Mode=OneWay}"
                                  Command="{Binding SelectExcludedCommand}"
                                  Content="제외"
                                  AutomationProperties.Name="{Binding ExcludedButtonAccessibleName}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border
            Padding="16"
            Background="{DynamicResource PaneSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
          <StackPanel Spacing="10">
            <StackPanel Spacing="3">
              <TextBlock FontWeight="SemiBold" Text="대안 과목 추가" />
              <TextBlock
                  Classes="caption"
                  Text="서로 다른 과목 중 하나만 들으면 되는 경우 과목을 검색해 같은 선택으로 묶으세요."
                  TextWrapping="Wrap" />
            </StackPanel>
            <Grid>
              <TextBox
                  x:Name="AlternativeCourseSearchBox"
                  Padding="36,0,12,0"
                  Text="{Binding AlternativeCourseSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="과목명 또는 코드 검색"
                  AutomationProperties.AutomationId="AlternativeCourseSearchBox"
                  AutomationProperties.Name="대안 과목 검색" />
              <icons:FluentIcon
                  Width="18"
                  Height="18"
                  Margin="11,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Icon="Search"
                  IconVariant="Regular"
                  Foreground="{DynamicResource TextTertiaryBrush}"
                  IsHitTestVisible="False" />
            </Grid>
            <ScrollViewer
                MaxHeight="220"
                IsVisible="{Binding HasAlternativeCourseSearchResults}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding AlternativeCourseSearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CourseChoiceAlternativeSearchItem">
                    <Border
                        Padding="10,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Classes="caption" Text="{Binding Code}" />
                            <TextBlock Classes="caption" Text="{Binding DetailText}" />
                          </StackPanel>
                          <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="outline"
                            MinHeight="36"
                            Padding="10,0"
                            Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).AddAlternativeCourseCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding AddButtonAccessibleName}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="15" />
                            <TextBlock Text="추가" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock
                Classes="caption"
                IsVisible="{Binding HasNoAlternativeCourseSearchResults}"
                Text="검색 결과가 없다면 이미 다른 수강 선택에 포함되었거나 시간 정보가 없는 과목일 수 있습니다."
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel
          Grid.Column="0"
          Orientation="Horizontal"
          Spacing="8"
          VerticalAlignment="Center"
          IsVisible="{Binding HasIncompleteCourseChoice}">
        <icons:FluentIcon
            Width="17"
            Height="17"
            Icon="Info"
            IconVariant="Regular"
            Foreground="{DynamicResource AccentBrush}" />
        <TextBlock
            Classes="caption"
            VerticalAlignment="Center"
            Text="{Binding CourseChoiceValidationMessage}"
            TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button
            Classes="outline"
            Command="{Binding CancelCourseChoiceEditCommand}"
            Content="취소" />
        <Button
            x:Name="SaveCourseChoiceButton"
            Classes="accent"
            IsEnabled="{Binding CanSaveCourseChoice}"
            Command="{Binding SaveCourseChoiceCommand}"
            Content="선택 저장"
            AutomationProperties.AutomationId="SaveCourseChoice" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
