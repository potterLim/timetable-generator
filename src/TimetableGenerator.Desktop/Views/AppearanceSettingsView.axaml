<UserControl
    x:Class="TimetableGenerator.Desktop.Views.AppearanceSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:TimetableGenerator.Desktop.Presentation.Appearance"
    x:DataType="appearance:ProductAppearanceViewModel"
    Width="276"
    AutomationProperties.Name="화면 모드 설정">
  <StackPanel Margin="4" Spacing="4">
    <StackPanel Margin="12,8,12,10" Spacing="4">
      <TextBlock
          FontSize="16"
          FontWeight="SemiBold"
          Text="화면 모드" />
      <TextBlock
          Classes="secondary"
          FontSize="12"
          LineHeight="18"
          Text="시스템은 Windows 또는 macOS 설정을 따릅니다."
          TextWrapping="Wrap" />
    </StackPanel>

    <RadioButton
        x:Name="SystemThemeOption"
        MinHeight="44"
        Padding="12,8"
        GroupName="ProductThemePreference"
        IsChecked="{Binding IsSystemThemeSelected, Mode=TwoWay}"
        Content="시스템"
        AutomationProperties.Name="시스템 모드 사용" />
    <RadioButton
        x:Name="LightThemeOption"
        MinHeight="44"
        Padding="12,8"
        GroupName="ProductThemePreference"
        IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"
        Content="라이트"
        AutomationProperties.Name="라이트 모드 사용" />
    <RadioButton
        x:Name="DarkThemeOption"
        MinHeight="44"
        Padding="12,8"
        GroupName="ProductThemePreference"
        IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"
        Content="다크"
        AutomationProperties.Name="다크 모드 사용" />

    <Border
        Margin="8,8,8,4"
        Padding="10"
        IsVisible="{Binding HasPersistenceFailure}"
        Background="{DynamicResource WarningSubtleBrush}"
        CornerRadius="6"
        AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource WarningBrush}"
            Text="{Binding PersistenceFailureMessage}"
            TextWrapping="Wrap" />
        <Button
            x:Name="RetryAppearancePersistenceButton"
            Grid.Column="1"
            Classes="outline"
            MinHeight="32"
            Padding="10,4"
            VerticalAlignment="Center"
            Command="{Binding RetryPersistenceCommand}"
            Content="다시 저장"
            AutomationProperties.Name="화면 모드 다시 저장" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
