<UserControl
    x:Class="TimetableGenerator.Desktop.Views.PlanInspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    AutomationProperties.LandmarkType="Complementary"
    AutomationProperties.Name="내 계획">
  <UserControl.Styles>
    <Style Selector="Border.plan-course.blue">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.green">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource PaneSurfaceBrush}"
      BorderBrush="{DynamicResource PaneDividerBrush}"
      BorderThickness="1,0,0,0">
    <Grid Margin="22,20,22,18" RowDefinitions="Auto,12,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <TextBlock
            Classes="title"
            AutomationProperties.HeadingLevel="2"
            Text="내 계획" />
        <Button
            Grid.Column="1"
            Classes="icon"
            AutomationProperties.Name="현재 계획 관리"
            ToolTip.Tip="계획 관리">
          <icons:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="20" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="174" Margin="4" Spacing="2">
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding BeginRenamePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="이름 바꾸기" />
                  </StackPanel>
                </Button>
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="{DynamicResource ErrorBrush}"
                    IsEnabled="{Binding CanDeleteActivePlan}"
                    Command="{Binding BeginDeletePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="계획 닫기" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button
            x:Name="CloseInspectorPaneButton"
            Grid.Column="2"
            Classes="icon"
            Width="32"
            Height="32"
            MinWidth="32"
            MinHeight="32"
            IsVisible="{Binding IsInspectorPaneToggleVisible}"
            Command="{Binding ToggleInspectorPaneCommand}"
            AutomationProperties.Name="내 계획 패널 닫기"
            ToolTip.Tip="내 계획 닫기">
          <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
        </Button>
      </Grid>

      <ScrollViewer
          x:Name="PlanInspectorScrollViewer"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Classes="secondary"
                Text="선택한 과목" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ActivePlan.CreditSummary}"
                AutomationProperties.Name="선택한 과목과 학점" />
          </Grid>

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <Border
              x:Name="EmptyPlanState"
              Padding="18,24"
              IsVisible="{Binding ActivePlan.IsCompletelyEmpty}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="10">
            <StackPanel Spacing="8">
              <Border
                  Width="40"
                  Height="40"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentTintBrush}"
                  CornerRadius="20">
                <icons:FluentIcon
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="CalendarEmpty"
                    IconVariant="Regular"
                    Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <TextBlock
                  Margin="0,4,0,0"
                  FontWeight="SemiBold"
                  Text="아직 계획이 비어 있습니다"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="caption"
                  LineHeight="18"
                  Text="과목을 고르거나 개인 일정을 추가해 나만의 시간표를 시작하세요."
                  TextWrapping="Wrap" />
              <Button
                  Classes="outline"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Left"
                  Command="{Binding BeginAddPersonalScheduleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="17" />
                  <TextBlock Text="개인 일정 추가" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Border
              Padding="12,10"
              IsVisible="{Binding ActivePlan.HasOnlyPersonalSchedules}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <TextBlock
                Classes="caption"
                Text="선택한 과목은 없습니다. 개인 일정만으로도 시간표를 저장할 수 있어요."
                TextWrapping="Wrap" />
          </Border>

          <TextBlock
              FontWeight="SemiBold"
              IsVisible="{Binding ActivePlan.HasScheduledCourses}"
              Text="{Binding ActivePlan.ScheduledCourseHeading}" />

          <ListBox
              x:Name="ScheduledCoursesList"
              Classes="workspace-list"
              MaxHeight="360"
              IsVisible="{Binding ActivePlan.HasScheduledCourses}"
              ItemsSource="{Binding ActivePlan.ScheduledCourses}"
              AutomationProperties.AutomationId="SelectedCourses"
              AutomationProperties.Name="선택한 수강 과목">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:PlanCourseItem">
                <Border
                    Classes="plan-course"
                    Classes.blue="{Binding IsBlue}"
                    Classes.purple="{Binding IsPurple}"
                    Classes.green="{Binding IsGreen}"
                    MinHeight="91"
                    BorderThickness="3,0,0,1"
                    Background="{DynamicResource PaneSurfaceBrush}">
                  <Grid Margin="13,9,7,8" ColumnDefinitions="*,36" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        Classes="caption"
                        Text="{Binding InstructorCreditDisplayText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,3,0,0"
                        Classes="caption"
                        Text="{Binding ScheduleLocationDisplayText}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="1"
                        Classes="icon"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        MinHeight="32"
                        VerticalAlignment="Top"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveCourseCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="계획에서 제거">
                      <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Expander
              x:Name="TimeNotProvidedCoursesExpander"
              IsVisible="{Binding ActivePlan.HasUnconfirmedCourses}"
              IsExpanded="True"
              AutomationProperties.Name="시간 미정 과목">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:FluentIcon
                    Width="18"
                    Height="18"
                    Icon="Warning"
                    IconVariant="Filled"
                    Foreground="{DynamicResource WarningBrush}" />
                <TextBlock FontWeight="SemiBold" Text="{Binding ActivePlan.UnconfirmedHeading}" />
              </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding ActivePlan.UnconfirmedCourses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PlanCourseItem">
                  <Border
                      Margin="0,7,0,0"
                      Padding="12,9,6,9"
                      CornerRadius="6"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Background="{DynamicResource SubtleSurfaceBrush}">
                    <Grid ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                      <TextBlock Grid.Row="1" Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Margin="0,4,0,0" Classes="caption" Text="{Binding InstructorCreditDisplayText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Margin="0,3,0,0" Classes="caption" Text="{Binding ScheduleLocationDisplayText}" TextWrapping="Wrap" />
                      <Button
                          Grid.Row="0"
                          Grid.RowSpan="4"
                          Grid.Column="1"
                          Classes="icon"
                          Width="32"
                          Height="32"
                          MinWidth="32"
                          MinHeight="32"
                          Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveCourseCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                          ToolTip.Tip="계획에서 제거">
                        <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <Grid x:Name="PersonalSchedulesSection" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ActivePlan.PersonalScheduleHeading}" />
            <Button
                x:Name="AddPersonalScheduleButton"
                Grid.Column="1"
                Classes="subtle"
                MinHeight="36"
                Padding="10,6"
                Command="{Binding BeginAddPersonalScheduleCommand}"
                AutomationProperties.AutomationId="AddPersonalSchedule"
                AutomationProperties.Name="개인 일정 추가"
                ToolTip.Tip="개인 일정 추가">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="16" />
                <TextBlock VerticalAlignment="Center" Text="추가" />
              </StackPanel>
            </Button>
          </Grid>

          <Border
              x:Name="PersonalScheduleEmptyState"
              Padding="12"
              IsVisible="{Binding !ActivePlan.HasPersonalSchedules}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <TextBlock
                Classes="caption"
                LineHeight="18"
                Text="식사, 랩 미팅, 고정 약속처럼 수업 외 시간을 미리 비워둘 수 있어요."
                TextWrapping="Wrap" />
          </Border>

          <ItemsControl
              x:Name="PersonalSchedulesList"
              IsVisible="{Binding ActivePlan.HasPersonalSchedules}"
              ItemsSource="{Binding ActivePlan.PersonalSchedules}"
              AutomationProperties.Name="개인 일정 목록">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PersonalScheduleItem">
                <Border
                    Margin="0,0,0,8"
                    Padding="12,10,6,10"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource PersonalScheduleBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PersonalScheduleBackgroundBrush}">
                  <Grid ColumnDefinitions="*,42,42" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Classes="caption"
                        Text="{Binding TimeSummary}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,3,0,0"
                        Classes="caption"
                        IsVisible="{Binding HasDetails}"
                        Text="{Binding DetailsSummary}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Classes="icon"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        VerticalAlignment="Top"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginEditPersonalScheduleCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding EditButtonAccessibleName}"
                        ToolTip.Tip="일정 수정">
                      <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="16" />
                    </Button>
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Classes="icon"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        VerticalAlignment="Top"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginDeletePersonalScheduleCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="일정 삭제">
                      <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border
              x:Name="RecommendationPolicyCard"
              Padding="12"
              IsVisible="{Binding !ActivePlan.IsCompletelyEmpty}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <icons:FluentIcon
                  Grid.Column="0"
                  Icon="CheckmarkCircle"
                  IconVariant="Regular"
                  FontSize="18"
                  Foreground="{DynamicResource AccentBrush}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="추천 기준" />
                <TextBlock
                    Classes="caption"
                    LineHeight="18"
                    Text="과목과 개인 일정이 겹치지 않는 분반 조합만 추천합니다. 시간 미정 과목은 별도로 보관합니다."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
