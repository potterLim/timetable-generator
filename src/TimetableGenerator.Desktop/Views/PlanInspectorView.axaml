<UserControl
    x:Class="TimetableGenerator.Desktop.Views.PlanInspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    x:CompileBindings="False"
    AutomationProperties.LandmarkType="Complementary"
    AutomationProperties.Name="내 계획">
  <UserControl.Styles>
    <Style Selector="Border.plan-course.blue">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.green">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1,0,0,0">
    <Grid Margin="22,20,22,18" RowDefinitions="Auto,Auto,Auto,12,Auto,18,1,14,Auto,8,*,14,1,12,Auto,14,1,14,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock
            Classes="title"
            AutomationProperties.HeadingLevel="2"
            Text="내 계획" />
        <Button
            Grid.Column="1"
            Classes="icon"
            AutomationProperties.Name="현재 계획 관리"
            ToolTip.Tip="계획 관리">
          <icons:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="20" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="174" Margin="4" Spacing="2">
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding BeginRenamePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="이름 바꾸기" />
                  </StackPanel>
                </Button>
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="{DynamicResource ErrorBrush}"
                    IsEnabled="{Binding CanDeleteActivePlan}"
                    Command="{Binding BeginDeletePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="계획 삭제" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Border
          Grid.Row="1"
          Margin="0,12,0,0"
          Padding="12"
          IsVisible="{Binding IsRenamingPlan}"
          Background="{DynamicResource SubtleSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="7">
        <StackPanel Spacing="9">
          <TextBlock FontWeight="SemiBold" Text="계획 이름" />
          <TextBox
              MaxLength="80"
              Text="{Binding PlanNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AutomationProperties.Name="계획 이름" />
          <TextBlock
              FontSize="12"
              Foreground="{DynamicResource ErrorBrush}"
              IsVisible="{Binding HasPlanNameValidationMessage}"
              Text="{Binding PlanNameValidationMessage}" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="outline" Command="{Binding CancelRenamePlanCommand}" Content="취소" />
            <Button Classes="accent" Command="{Binding ConfirmRenamePlanCommand}" Content="저장" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border
          Grid.Row="2"
          Margin="0,12,0,0"
          Padding="12"
          IsVisible="{Binding IsDeletePlanConfirmationVisible}"
          Background="{DynamicResource SubtleSurfaceBrush}"
          BorderBrush="{DynamicResource ErrorBrush}"
          BorderThickness="1"
          CornerRadius="7">
        <StackPanel Spacing="9">
          <TextBlock FontWeight="SemiBold" Text="이 계획을 삭제할까요?" />
          <TextBlock
              Classes="caption"
              Text="선택한 과목과 추천 결과가 함께 삭제됩니다."
              TextWrapping="Wrap" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="outline" Command="{Binding CancelDeletePlanCommand}" Content="취소" />
            <Button
                Background="{DynamicResource ErrorBrush}"
                Foreground="White"
                Command="{Binding ConfirmDeletePlanCommand}"
                Content="삭제" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
        <TextBlock
            VerticalAlignment="Center"
            Classes="secondary"
            Text="선택한 과목" />
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{Binding ActivePlan.CreditSummary}"
            AutomationProperties.Name="선택한 과목과 학점" />
      </Grid>

      <Border Grid.Row="6" Background="{DynamicResource BorderBrush}" />

      <TextBlock
          Grid.Row="8"
          FontWeight="SemiBold"
          Text="{Binding ActivePlan.ScheduledCourseHeading}" />

      <ListBox
          Grid.Row="10"
          Classes="workspace-list"
          ItemsSource="{Binding ActivePlan.ScheduledCourses}"
          AutomationProperties.AutomationId="SelectedCourses"
          AutomationProperties.Name="선택한 수강 과목">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:PlanCourseItem">
            <Border
                Classes="plan-course"
                Classes.blue="{Binding IsBlue}"
                Classes.purple="{Binding IsPurple}"
                Classes.green="{Binding IsGreen}"
                MinHeight="91"
                BorderThickness="3,0,0,1"
                Background="{DynamicResource SurfaceBrush}">
              <Grid Margin="13,9,7,8" ColumnDefinitions="*,36" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="2" Margin="0,5,0,0" Orientation="Horizontal" Spacing="7">
                  <TextBlock Classes="caption" Text="{Binding InstructorDisplayText}" />
                  <TextBlock Classes="caption" Text="·" />
                  <TextBlock Classes="caption" Text="{Binding CreditDisplayText}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="3"
                    Margin="0,3,0,0"
                    Classes="caption"
                    Text="{Binding MeetingDisplayText}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    Classes="icon"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    VerticalAlignment="Top"
                    Command="{Binding DataContext.RemoveCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                    ToolTip.Tip="계획에서 제거">
                  <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="12" Background="{DynamicResource BorderBrush}" />

      <Expander
          Grid.Row="14"
          IsExpanded="True"
          AutomationProperties.Name="시간 미정 과목">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:FluentIcon
                Width="18"
                Height="18"
                Icon="Warning"
                IconVariant="Filled"
                Foreground="{DynamicResource WarningBrush}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding ActivePlan.UnconfirmedHeading}" />
          </StackPanel>
        </Expander.Header>
        <Grid RowDefinitions="Auto,Auto">
          <TextBlock
              Grid.Row="0"
              Margin="0,8,0,2"
              Classes="caption"
              IsVisible="{Binding !ActivePlan.HasUnconfirmedCourses}"
              Text="선택한 시간 미정 분반이 없습니다."
              TextWrapping="Wrap" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding ActivePlan.UnconfirmedCourses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:PlanCourseItem">
                <Border
                    Margin="0,7,0,0"
                    Padding="12,9,6,9"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource SubtleSurfaceBrush}">
                  <Grid ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                    <TextBlock Grid.Row="1" Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
                    <StackPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="caption" Text="{Binding InstructorDisplayText}" />
                      <TextBlock Classes="caption" Text="·" />
                      <TextBlock Classes="caption" Text="{Binding CreditDisplayText}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,3,0,0" Classes="caption" Text="{Binding MeetingDisplayText}" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="1"
                        Classes="icon"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        MinHeight="32"
                        Command="{Binding DataContext.RemoveCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="계획에서 제거">
                      <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Expander>

      <Border Grid.Row="16" Background="{DynamicResource BorderBrush}" />

      <Border
          Grid.Row="18"
          Padding="12"
          Background="{DynamicResource SubtleSurfaceBrush}"
          CornerRadius="7">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
          <icons:FluentIcon
              Grid.Column="0"
              Icon="CheckmarkCircle"
              IconVariant="Regular"
              FontSize="18"
              Foreground="{DynamicResource AccentBrush}" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="추천 기준" />
            <TextBlock
                Classes="caption"
                LineHeight="18"
                Text="선택한 분반 후보 중 시간이 겹치지 않는 조합만 표시합니다. 시간 미정 분반은 별도로 유지합니다."
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
