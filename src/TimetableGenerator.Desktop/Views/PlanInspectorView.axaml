<UserControl
    x:Class="TimetableGenerator.Desktop.Views.PlanInspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    xmlns:viewModels="using:TimetableGenerator.Desktop.Presentation.ViewModels"
    x:DataType="viewModels:PlannerWorkspaceViewModel"
    AutomationProperties.LandmarkType="Complementary"
    AutomationProperties.Name="{Binding ActivePlanOrNull.DisplayName}">
  <UserControl.Styles>
    <Style Selector="Border.plan-course.blue">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.green">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
    </Style>
    <Style Selector="Border.course-choice-group">
      <Setter Property="Background" Value="{DynamicResource PaneSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.course-choice-group.alternative">
      <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource PaneSurfaceBrush}"
      BorderBrush="{DynamicResource PaneDividerBrush}"
      BorderThickness="1,0,0,0">
    <Grid Margin="22,20,0,18" RowDefinitions="Auto,12,*">
      <Grid
          Grid.Row="0"
          Margin="0,0,22,0"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="4">
        <Button
            x:Name="PlanManagementButton"
            Grid.Column="0"
            Classes="plan-title-action"
            AutomationProperties.Name="{Binding ActivePlanOrNull.DisplayName}"
            AutomationProperties.HelpText="계획 관리"
            AutomationProperties.HeadingLevel="2"
            ToolTip.Tip="계획 관리">
          <TextBlock
              x:Name="PlanManagementTitle"
              Classes="title"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Text="{Binding ActivePlanOrNull.DisplayName}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel MinWidth="148" Margin="4" Spacing="2">
                <Button
                    Classes="plan-management-action"
                    Click="onPlanManagementActionClick"
                    Command="{Binding BeginRenamePlanCommand}"
                    AutomationProperties.Name="현재 계획 이름 바꾸기">
                  <StackPanel Classes="plan-action-content">
                    <icons:FluentIcon Classes="plan-action-icon" Icon="Edit" IconVariant="Regular" />
                    <TextBlock Classes="plan-action-label" Text="이름 바꾸기" />
                  </StackPanel>
                </Button>
                <Button
                    x:Name="ClearActivePlanButton"
                    Classes="plan-management-action destructive"
                    IsEnabled="{Binding CanClearActivePlan}"
                    Click="onPlanManagementActionClick"
                    Command="{Binding BeginClearActivePlanCommand}"
                    AutomationProperties.Name="현재 시간표 비우기">
                  <StackPanel Classes="plan-action-content">
                    <icons:FluentIcon Classes="plan-action-icon" Icon="Delete" IconVariant="Regular" />
                    <TextBlock Classes="plan-action-label" Text="시간표 비우기" />
                  </StackPanel>
                </Button>
                <Button
                    Classes="plan-management-action destructive"
                    IsEnabled="{Binding CanDeleteActivePlan}"
                    Click="onPlanManagementActionClick"
                    Command="{Binding BeginDeletePlanCommand}"
                    AutomationProperties.Name="현재 계획 삭제">
                  <StackPanel Classes="plan-action-content">
                    <icons:FluentIcon Classes="plan-action-icon" Icon="Delete" IconVariant="Regular" />
                    <TextBlock Classes="plan-action-label" Text="계획 삭제" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button
            x:Name="CloseInspectorPaneButton"
            Grid.Column="1"
            Classes="icon"
            IsVisible="{Binding IsInspectorPaneDismissActionVisible}"
            Command="{Binding CloseInspectorPaneCommand}"
            AutomationProperties.Name="내 계획 패널 닫기"
            ToolTip.Tip="계획 닫기">
          <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
        </Button>
      </Grid>

      <ScrollViewer
          x:Name="PlanInspectorScrollViewer"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PlanInspectorScrollableContent"
            Margin="0,0,16,0"
            Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                x:Name="ExpectedCreditsLabel"
                VerticalAlignment="Center"
                Classes="secondary"
                Text="예상 학점" />
            <TextBlock
                x:Name="ExpectedCreditsValue"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ActivePlanOrNull.ExpectedCreditsDisplayText}"
                AutomationProperties.Name="{Binding ActivePlanOrNull.ExpectedCreditsAccessibleName}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <Border
              x:Name="EmptyPlanState"
              Padding="18,22"
              IsVisible="{Binding ActivePlanOrNull.IsCompletelyEmpty}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="10">
            <StackPanel
                x:Name="EmptyPlanStateContent"
                HorizontalAlignment="Stretch"
                Spacing="7">
              <Border
                  x:Name="EmptyPlanStateIconSurface"
                  Width="40"
                  Height="40"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource AccentTintBrush}"
                  CornerRadius="20">
                <icons:FluentIcon
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="CalendarEmpty"
                    IconVariant="Regular"
                    Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <TextBlock
                  x:Name="EmptyPlanStateHeading"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Stretch"
                  FontWeight="SemiBold"
                  Text="선택한 과목이 없습니다"
                  TextAlignment="Center"
                  TextWrapping="NoWrap" />
              <TextBlock
                  x:Name="EmptyPlanStateDescription"
                  Classes="caption"
                  HorizontalAlignment="Stretch"
                  Text="과목을 선택해 시간표를 구성해 보세요."
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              Padding="12,10"
              IsVisible="{Binding ActivePlanOrNull.HasOnlyPersonalSchedules}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <TextBlock
                Classes="caption"
                Text="과목 없이 개인 일정만 저장할 수 있습니다."
                TextWrapping="NoWrap" />
          </Border>

          <TextBlock
              x:Name="ScheduledCoursesHeading"
              FontWeight="SemiBold"
              IsVisible="{Binding ActivePlanOrNull.HasScheduledCourses}"
              Text="{Binding ActivePlanOrNull.ScheduledCourseHeading}" />

          <ListBox
              x:Name="ScheduledCoursesList"
              Classes="workspace-list"
              IsVisible="{Binding ActivePlanOrNull.HasScheduledCourses}"
              ItemsSource="{Binding ActivePlanOrNull.CourseChoiceGroups}"
              AutomationProperties.AutomationId="SelectedCourses"
              AutomationProperties.Name="선택한 수강 선택">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:PlanCourseChoiceGroupItem">
                <Grid>
                  <Border
                      Classes="plan-course"
                      Classes.blue="{Binding SingleCourse.IsBlue}"
                      Classes.purple="{Binding SingleCourse.IsPurple}"
                      Classes.green="{Binding SingleCourse.IsGreen}"
                      Margin="0,0,0,10"
                      Padding="12,10,7,10"
                      IsVisible="{Binding IsSingleCourseGroup}"
                      Background="{DynamicResource SubtleSurfaceBrush}"
                      BorderThickness="3,1,1,1"
                      CornerRadius="9">
                    <Grid ColumnDefinitions="*,34,34" ColumnSpacing="2">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Classes="caption" Text="{Binding SingleCourse.Code}" />
                          <TextBlock Classes="caption" Text="{Binding SingleCourse.CreditDisplayText}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding SingleCourse.Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip.Tip="{Binding SingleCourse.Name}" />
                        <TextBlock Classes="caption" Text="{Binding SingleCourse.PreferenceSummary}" />
                      </StackPanel>
                      <Button
                          x:Name="CourseChoiceGroupEditButton"
                          Grid.Column="1"
                          Classes="icon compact"
                          Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginEditCourseChoiceGroupCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding EditButtonAccessibleName}"
                          ToolTip.Tip="분반 선호 수정">
                        <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="16" />
                      </Button>
                      <Button
                          Grid.Column="2"
                          Classes="icon compact"
                          Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveCourseChoiceGroupCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                          ToolTip.Tip="계획에서 삭제">
                        <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" />
                      </Button>
                    </Grid>
                  </Border>

                  <Border
                      Classes="course-choice-group alternative"
                      Margin="0,0,0,10"
                      IsVisible="{Binding IsAlternativeGroup}">
                    <StackPanel>
                      <Grid Margin="12,9,7,8" ColumnDefinitions="*,34,34" ColumnSpacing="2">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource AccentBrush}"
                              Text="이 중 하나" />
                          <TextBlock
                              Classes="caption"
                              Text="{Binding Description}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="NoWrap"
                              ToolTip.Tip="{Binding Description}" />
                        </StackPanel>
                        <Button
                            x:Name="AlternativeCourseChoiceGroupEditButton"
                            Grid.Column="1"
                            Classes="icon compact"
                            Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginEditCourseChoiceGroupCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding EditButtonAccessibleName}"
                            ToolTip.Tip="대안 과목과 분반 선호 수정">
                          <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Classes="icon compact"
                            Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveCourseChoiceGroupCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                            ToolTip.Tip="대안 묶음을 계획에서 삭제">
                          <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" />
                        </Button>
                      </Grid>

                    <ItemsControl ItemsSource="{Binding Courses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlanCourseChoiceCandidateItem">
                          <Border
                              Classes="plan-course"
                              Classes.blue="{Binding IsBlue}"
                              Classes.purple="{Binding IsPurple}"
                              Classes.green="{Binding IsGreen}"
                              Padding="12,9"
                              Background="{DynamicResource SubtleSurfaceBrush}"
                              BorderThickness="3,1,1,0">
                            <StackPanel Spacing="3">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="caption" Text="{Binding Code}" />
                                <TextBlock Classes="caption" Text="{Binding CreditDisplayText}" />
                              </StackPanel>
                              <TextBlock
                                  FontSize="15"
                                  FontWeight="SemiBold"
                                  Text="{Binding Name}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap"
                                  ToolTip.Tip="{Binding Name}" />
                              <TextBlock Classes="caption" Text="{Binding PreferenceSummary}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Expander
              x:Name="TimeNotProvidedCoursesExpander"
              IsVisible="{Binding ActivePlanOrNull.HasTimeNotProvidedCourses}"
              IsExpanded="True"
              AutomationProperties.Name="시간 미정 과목">
            <Expander.Header>
              <StackPanel
                  Classes="button-content"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="8">
                <icons:FluentIcon
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Icon="Warning"
                    IconVariant="Filled"
                    Foreground="{DynamicResource WarningBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding ActivePlanOrNull.TimeNotProvidedHeading}" />
              </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding ActivePlanOrNull.TimeNotProvidedCourses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TimeNotProvidedCourseItem">
                  <Border
                      Margin="0,7,0,0"
                      Padding="12,9,6,9"
                      CornerRadius="6"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Background="{DynamicResource SubtleSurfaceBrush}">
                    <Grid ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                      <TextBlock Grid.Row="1" Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Margin="0,4,0,0" Classes="caption" Text="{Binding InstructorCreditDisplayText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Margin="0,3,0,0" Classes="caption" Text="{Binding ScheduleLocationDisplayText}" TextWrapping="Wrap" />
                      <Button
                          Grid.Row="0"
                          Grid.RowSpan="4"
                          Grid.Column="1"
                          Classes="icon compact"
                          Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).RemoveTimeNotProvidedCourseCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                          ToolTip.Tip="계획에서 제거">
                        <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <Grid x:Name="PersonalSchedulesSection" ColumnDefinitions="*,Auto">
            <TextBlock
                x:Name="PersonalSchedulesHeading"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ActivePlanOrNull.PersonalScheduleHeading}" />
            <Button
                x:Name="AddPersonalScheduleButton"
                Grid.Column="1"
                Classes="subtle"
                MinHeight="36"
                Padding="10,0"
                Command="{Binding BeginAddPersonalScheduleCommand}"
                AutomationProperties.AutomationId="AddPersonalSchedule"
                AutomationProperties.Name="개인 일정 추가"
                ToolTip.Tip="개인 일정 추가">
              <StackPanel Classes="button-content" Orientation="Horizontal" Spacing="5">
                <icons:FluentIcon Icon="Add" IconVariant="Regular" FontSize="16" />
                <TextBlock VerticalAlignment="Center" Text="추가" />
              </StackPanel>
            </Button>
          </Grid>

          <Border
              x:Name="PersonalScheduleEmptyState"
              Padding="12"
              IsVisible="{Binding !ActivePlanOrNull.HasPersonalSchedules}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <TextBlock
                Classes="caption"
                Text="수업 외 고정 일정을 추가하세요."
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTip.Tip="수업 외 고정 일정을 추가하세요." />
          </Border>

          <ItemsControl
              x:Name="PersonalSchedulesList"
              IsVisible="{Binding ActivePlanOrNull.HasPersonalSchedules}"
              ItemsSource="{Binding ActivePlanOrNull.PersonalSchedules}"
              AutomationProperties.Name="개인 일정 목록">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PersonalScheduleItem">
                <Border
                    Margin="0,0,0,8"
                    Padding="12,10,6,10"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource PersonalScheduleBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PersonalScheduleBackgroundBrush}">
                  <Grid ColumnDefinitions="*,42,42" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding Title}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Classes="caption"
                        Text="{Binding TimeSummary}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,3,0,0"
                        Classes="caption"
                        IsVisible="{Binding HasDetails}"
                        Text="{Binding DetailsSummary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip.Tip="{Binding DetailsSummary}" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Classes="icon"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        VerticalAlignment="Top"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginEditPersonalScheduleCommand}"
                        CommandParameter="{Binding Id}"
                        AutomationProperties.Name="{Binding EditButtonAccessibleName}"
                        ToolTip.Tip="일정 수정">
                      <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="16" />
                    </Button>
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Classes="icon"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        VerticalAlignment="Top"
                        Command="{Binding $parent[UserControl].((viewModels:PlannerWorkspaceViewModel)DataContext).BeginDeletePersonalScheduleCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="일정 삭제">
                      <icons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
