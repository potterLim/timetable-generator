<UserControl
    x:Class="TimetableGenerator.Desktop.Views.PlanInspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:models="using:TimetableGenerator.Desktop.Presentation.Models"
    x:CompileBindings="False"
    AutomationProperties.LandmarkType="Complementary"
    AutomationProperties.Name="내 계획">
  <UserControl.Styles>
    <Style Selector="Border.plan-course.blue">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseBlueBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource CoursePurpleBorderBrush}" />
    </Style>
    <Style Selector="Border.plan-course.green">
      <Setter Property="BorderBrush" Value="{DynamicResource CourseGreenBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Border
      Background="{DynamicResource PaneSurfaceBrush}"
      BorderBrush="{DynamicResource PaneDividerBrush}"
      BorderThickness="1,0,0,0">
    <Grid Margin="22,20,22,18" RowDefinitions="Auto,12,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <TextBlock
            Classes="title"
            AutomationProperties.HeadingLevel="2"
            Text="내 계획" />
        <Button
            Grid.Column="1"
            Classes="icon"
            AutomationProperties.Name="현재 계획 관리"
            ToolTip.Tip="계획 관리">
          <icons:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="20" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="174" Margin="4" Spacing="2">
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding BeginRenamePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="이름 바꾸기" />
                  </StackPanel>
                </Button>
                <Button
                    Padding="10,8"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="{DynamicResource ErrorBrush}"
                    IsEnabled="{Binding CanDeleteActivePlan}"
                    Command="{Binding BeginDeletePlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                    <TextBlock Text="계획 닫기" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button
            x:Name="CloseInspectorPaneButton"
            Grid.Column="2"
            Classes="icon"
            Width="32"
            Height="32"
            MinWidth="32"
            MinHeight="32"
            IsVisible="{Binding IsInspectorPaneToggleVisible}"
            Command="{Binding ToggleInspectorPaneCommand}"
            AutomationProperties.Name="내 계획 패널 닫기"
            ToolTip.Tip="내 계획 닫기">
          <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
        </Button>
      </Grid>

      <ScrollViewer
          x:Name="PlanInspectorScrollViewer"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,18,1,14,Auto,8,Auto,14,1,12,Auto,14,1,14,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Classes="secondary"
                Text="선택한 과목" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ActivePlan.CreditSummary}"
                AutomationProperties.Name="선택한 과목과 학점" />
          </Grid>

          <Border Grid.Row="2" Background="{DynamicResource BorderBrush}" />

          <Border
              x:Name="EmptyPlanState"
              Grid.Row="4"
              Padding="18,26"
              IsVisible="{Binding !ActivePlan.HasSelectedCourses}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="10">
            <StackPanel Spacing="8">
              <Border
                  Width="40"
                  Height="40"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentTintBrush}"
                  CornerRadius="20">
                <icons:FluentIcon
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="CalendarEmpty"
                    IconVariant="Regular"
                    Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <TextBlock
                  Margin="0,4,0,0"
                  FontWeight="SemiBold"
                  Text="아직 선택한 과목이 없습니다"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="caption"
                  LineHeight="18"
                  Text="왼쪽 과목 목록에서 +를 눌러 이 계획에 과목을 추가하세요."
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock
              Grid.Row="4"
              FontWeight="SemiBold"
              IsVisible="{Binding ActivePlan.HasScheduledCourses}"
              Text="{Binding ActivePlan.ScheduledCourseHeading}" />

          <ListBox
              x:Name="ScheduledCoursesList"
              Grid.Row="6"
              Classes="workspace-list"
              MaxHeight="360"
              IsVisible="{Binding ActivePlan.HasScheduledCourses}"
              ItemsSource="{Binding ActivePlan.ScheduledCourses}"
              AutomationProperties.AutomationId="SelectedCourses"
              AutomationProperties.Name="선택한 수강 과목">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="models:PlanCourseItem">
                <Border
                    Classes="plan-course"
                    Classes.blue="{Binding IsBlue}"
                    Classes.purple="{Binding IsPurple}"
                    Classes.green="{Binding IsGreen}"
                    MinHeight="91"
                    BorderThickness="3,0,0,1"
                    Background="{DynamicResource PaneSurfaceBrush}">
                  <Grid Margin="13,9,7,8" ColumnDefinitions="*,36" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        Classes="caption"
                        Text="{Binding InstructorCreditDisplayText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,3,0,0"
                        Classes="caption"
                        Text="{Binding ScheduleLocationDisplayText}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="1"
                        Classes="icon"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        MinHeight="32"
                        VerticalAlignment="Top"
                        Command="{Binding DataContext.RemoveCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                        ToolTip.Tip="계획에서 제거">
                      <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border
              Grid.Row="8"
              IsVisible="{Binding ActivePlan.HasUnconfirmedCourses}"
              Background="{DynamicResource BorderBrush}" />

          <Expander
              x:Name="TimeNotProvidedCoursesExpander"
              Grid.Row="10"
              IsVisible="{Binding ActivePlan.HasUnconfirmedCourses}"
              IsExpanded="True"
              AutomationProperties.Name="시간 미정 과목">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:FluentIcon
                    Width="18"
                    Height="18"
                    Icon="Warning"
                    IconVariant="Filled"
                    Foreground="{DynamicResource WarningBrush}" />
                <TextBlock FontWeight="SemiBold" Text="{Binding ActivePlan.UnconfirmedHeading}" />
              </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding ActivePlan.UnconfirmedCourses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:PlanCourseItem">
                    <Border
                        Margin="0,7,0,0"
                        Padding="12,9,6,9"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource SubtleSurfaceBrush}">
                      <Grid ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Code}" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            Classes="caption"
                            Text="{Binding InstructorCreditDisplayText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,3,0,0"
                            Classes="caption"
                            Text="{Binding ScheduleLocationDisplayText}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="4"
                            Grid.Column="1"
                            Classes="icon"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Command="{Binding DataContext.RemoveCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding RemoveButtonAccessibleName}"
                            ToolTip.Tip="계획에서 제거">
                          <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="17" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Border
              Grid.Row="12"
              IsVisible="{Binding ActivePlan.HasSelectedCourses}"
              Background="{DynamicResource BorderBrush}" />

          <Border
              x:Name="RecommendationPolicyCard"
              Grid.Row="14"
              Padding="12"
              IsVisible="{Binding ActivePlan.HasSelectedCourses}"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <icons:FluentIcon
                  Grid.Column="0"
                  Icon="CheckmarkCircle"
                  IconVariant="Regular"
                  FontSize="18"
                  Foreground="{DynamicResource AccentBrush}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="추천 기준" />
                <TextBlock
                    Classes="caption"
                    LineHeight="18"
                    Text="시간이 겹치지 않는 분반 조합만 추천합니다. 시간 미정 과목은 별도로 보관합니다."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
